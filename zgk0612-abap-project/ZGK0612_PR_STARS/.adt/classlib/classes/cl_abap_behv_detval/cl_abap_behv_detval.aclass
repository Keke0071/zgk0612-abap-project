class cl_abap_behv_detval definition
  public
  final
  create private .

  public section.

    types:
      begin of t_cud_instances,
        "! entity name should currently be entity name of a managed BO (no projection)
        entity_name type abp_entity_name,
        "! operation should have one of the values cl_abap_behv_detval-OP-*
        operation   type c length 1,
        "! instances should refer to a table type with absolute name
        "! cl_abap_behvdescr=>get_abs_typename( p_name = entity_name p_op = cl_abap_behvdescr=>op_notifications ).
        instances   type ref to data,
      end of t_cud_instances .
    types:
      tt_cud_instances type standard table of t_cud_instances with empty key .

    constants:
      begin of op,
        create  type c length 1 value if_abap_behv=>op-m-create,
        update  type c length 1 value if_abap_behv=>op-m-update,
        delete  type c length 1 value if_abap_behv=>op-m-delete,
        discard type c length 1 value 'd',
      end of op .

    "! Inform DVM about buffer changes
    "! @parameter changes            | table of changes
    "! @parameter eml_ticket         | eml ticket, the method dumps for non-permitted callers
    class-methods add_change_notification_tab
      importing
        !changes          type tt_cud_instances
        value(eml_ticket) type i default -1 .
    "! Execute validations on save. The method dumps for non-permitted callers.
    "! @parameter root_entity_name   | BO name
    "! @parameter log                | log, method adds results kind if_abap_behv_log=>reported_late
    "!                               | and if_abap_behv_log=>failed_late
    class-methods exec_validations_on_save
      importing
        !root_entity_name type abp_root_entity_name
        !log              type ref to if_abap_behv_log .
    "! Execute determinations on save. The method dumps for non-permitted callers.
    "! @parameter root_entity_name   | BO name
    "! @parameter log                | log, method adds result kind if_abap_behv_log=>reported_late
    class-methods exec_determinations_on_save
      importing
        !root_entity_name type abp_root_entity_name
        !log              type ref to if_abap_behv_log .
    "! Execute determinations on modify. The method dumps for non-permitted callers.
    "! @parameter root_entity_name   | BO name (as long as cross-BO modifications will not be permitted
    "!                               | in this execution of determinations, this parameter is redundant).
    "! @parameter log                | log, method adds result kind if_abap_behv_log=>reported
    "! @parameter for_unmanaged      | only execute determinations when root_entity_name is unmanaged
    class-methods exec_determinations_on_modify
      importing
        !root_entity_name type abp_root_entity_name
        !log              type ref to if_abap_behv_log
        !for_unmanaged    type sap_bool optional .
    "! Execute a determine action
    "! @parameter entity_name        | Entity where the determine action is defined
    "! @parameter det_act_name       | Name of the determine action
    "! @parameter instances          | Parameters of the determine action
    "! @parameter is_draft           | abap_true iff the determine action is the draft determine
    "!                                 action. In this case, the parameter table instances does not
    "!                                 have a column %IS_DRAFT, but parameters are draft instances.
    "!                                 The only draft determine action is PREPARE.
    "! @parameter log                | log, method adds result kind if_abap_behv_log=>reported
    class-methods exec_determine_action
      importing
        !entity_name  type abp_entity_name
        !det_act_name type cl_abap_behv_job_base=>t_sub_name
        !instances    type ref to data
        !is_draft     type sap_bool optional
        !log          type ref to if_abap_behv_log optional .
    class-methods check_finalize_is_complete.
    "! Cleanup method (at COMMIT or ROLLBACK)
    class-methods cleanup .
    "! Cleanup finalize method
    class-methods cleanup_finalize.
    "! Get control flags from dvm buffer
    "! @parameter entity_name        | Entity of this query
    "! @parameter keys               | Table whose line type has an include %tky for the given entity. For these
    "!                                 keys of the given entity, control flags shall be retrieved.
    "! @parameter control_flags      | May be initial when the result is empty, otherwise it
    "!                                 is a table created by cl_abap_behvdescr=>create_data( p_name = entity_name p_op = cl_abap_behvdescr=>op_notifications ).
    "!                                 It contains a line for each key from keys where a dvm buffer entry with operation update or create exists. Keys
    "!                                 that did not change in the current session may be omitted in the result (even in the case where a draft persistency entry exists).
    "!                                 Also keys are omitted when control flags do not matter (e.g. in case of deleted or discarded items).
    class-methods read_control_flags
      importing
        !entity_name type abp_entity_name
        keys         type index table
      returning value(control_flags) type ref to data.
    "! Is reexecution of determinations and validations in draft determine action prepare avoided for active instances if possible?
    "! @parameter root_name        | Root entity name
    "! @parameter flag             | abap_true iff activate draft action of root_name is optimized
    class-methods is_activate_optimized
      importing
        !root_name type abp_entity_name
      returning value(flag) type sap_bool.

    class-methods class_constructor .
  protected section.
  private section.
    class-data implementation type ref to if_abap_behv_detval.
    class-data mode type char1.
    class-methods set_flags importing value(abap_behv_detval) type char1.

    class-methods dump
      importing info type string optional.
    class-methods get_det_on_save_impls
      importing
                root_name    type abp_root_entity_name
      exporting rc           type i
      returning value(impls) type cl_abap_behv_ctrl=>tt_d010behv.
ENDCLASS.



CLASS CL_ABAP_BEHV_DETVAL IMPLEMENTATION.


  method add_change_notification_tab.
    "verify correct ticket or legal caller
    call 'BEHV_EXEC' id 'OP' field 16 id 'TICKET' field eml_ticket.

    if changes is initial.
      return.
    endif.

    if implementation is initial.
      implementation = new lcl_detval_with_trace( ).
    endif.
    implementation->add_change_notification_tab( changes = changes
                                                 for_eml = cond sap_bool( when eml_ticket eq -1 then space
                                                                          else 'X' ) ).
  endmethod.


  method check_finalize_is_complete.
    if implementation is not initial.
      implementation->check_finalize_is_complete( ).
    endif.
  endmethod.


  method class_constructor.
    data behv_detval type char1.
"    get parameter id 'ABAP_BEHV_DETVAL' field behv_detval.
    set_flags( behv_detval ).
  endmethod.


  method cleanup.
    "verify caller
    call 'BEHV_EXEC' id 'OP' field 16 id 'TICKET' field -1.

    if implementation is initial.
      return.
    endif.

    implementation->cleanup( ).
  endmethod.


  method cleanup_finalize.
    "verify caller
    call 'BEHV_EXEC' id 'OP' field 16 id 'TICKET' field -1.

    if implementation is initial.
      return.
    endif.

    implementation->cleanup_finalize( ).
  endmethod.


  method dump.

    raise shortdump type lcx_abap_behv_detval_error using message
      exporting
        tadir_key = cl_abap_behv_ctrl=>get_caller( )
        info      = info.

  endmethod.


  method exec_determinations_on_modify.
    "verify caller
    call 'BEHV_EXEC' id 'OP' field 16 id 'TICKET' field -1.

    if implementation is initial.
      return.
    endif.

    implementation->exec_determinations_on_modify( root_entity_name = root_entity_name log = log for_unmanaged = for_unmanaged ).
  endmethod.


  method exec_determinations_on_save.
    "verify caller
    call 'BEHV_EXEC' id 'OP' field 16 id 'TICKET' field -1.

    if implementation is initial.
      return.
    endif.

    implementation->exec_determinations_on_save( root_entity_name = root_entity_name log = log ).
  endmethod.


  method exec_determine_action.
    "verify caller
    call 'BEHV_EXEC' id 'OP' field 16 id 'TICKET' field -1.

    if implementation is initial.
      implementation = new lcl_detval_with_trace( ).
    endif.

    implementation->exec_determine_action( entity_name  = entity_name
                                           det_act_name = det_act_name
                                           instances    = instances
                                           is_draft     = is_draft
                                           log          = log ).

  endmethod.


  method exec_validations_on_save.
    "verify caller
    call 'BEHV_EXEC' id 'OP' field 16 id 'TICKET' field -1.

    if implementation is initial.
      return.
    endif.

    implementation->exec_validations( root_entity_name = root_entity_name log = log ).
  endmethod.


  method get_det_on_save_impls.
    data bdi_ops type cl_abap_behv_ctrl=>tt_d010behv.
    cl_abap_behv_ctrl=>get_implementations_krn(
      exporting root_entity = root_name
                kind_pos    = 'd'  " include new on save [d]etermination methods
                kind_neg    = 'L'  " exclude [L]ock methods
      importing rc          = rc
      changing  impl_ops    = bdi_ops   " (appending)
    ).
    impls = bdi_ops.
  endmethod.


  method is_activate_optimized.
    data(root) = root_name.
    cl_abap_behv_load=>get_load(
         exporting
           entity      = root_name
         importing
           head        = data(bo_head)
         changing
           root_entity = root
            ).
    flag = bo_head-activate_optimized.
  endmethod.


  method read_control_flags.
    "verify caller
    call 'BEHV_EXEC' id 'OP' field 16 id 'TICKET' field -1.

    if implementation is initial.
      return.
    endif.

    implementation->read_control_flags( exporting entity_name   = entity_name
                                                  keys          = keys
                                        receiving control_flags = control_flags ).


  endmethod.


  method set_flags.
    mode = abap_behv_detval.
  endmethod.
ENDCLASS.