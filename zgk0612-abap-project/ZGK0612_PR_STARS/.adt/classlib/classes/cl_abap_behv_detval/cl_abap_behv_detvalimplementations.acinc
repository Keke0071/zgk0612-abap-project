class lcl_detval definition.
  public section.
    methods constructor.

    interfaces if_abap_behv_detval.
    aliases:
      add_change_notification_tab for if_abap_behv_detval~add_change_notification_tab,
      exec_validations for if_abap_behv_detval~exec_validations,
      exec_determinations_on_save for if_abap_behv_detval~exec_determinations_on_save,
      exec_determinations_on_modify for if_abap_behv_detval~exec_determinations_on_modify,
      exec_determine_action for if_abap_behv_detval~exec_determine_action,
      cleanup for if_abap_behv_detval~cleanup,
      cleanup_finalize for if_abap_behv_detval~cleanup_finalize,
      read_control_flags for if_abap_behv_detval~read_control_flags.

    constants flags_none type x length 1 value 0.
    constants flag_draft_only type x length 1 value 1. "for detvals of unmanaged base BO with managed draft
    constants flag_not_in_local_mode type x length 1 value 2.
    constants flag_has_on_mod type x length 1 value 4.
    constants flag_has_on_mod_field type x length 1 value 16.
    constants flag_detval_has_cud_trigger type x length 1 value 64.
    constants flag_detval_has_field_trigger type x length 1 value 128.

    data is_optimization1_active type sap_bool.

  protected section. "relevant for xtrace and tests
    types: begin of t_job_params,
             root_name   type abp_root_entity_name,
             entity_name type abp_entity_name,
             detval_name type abp_detval_name,
             instances   type ref to data,
           end of t_job_params.
    types tt_job_params type hashed table of t_job_params with unique key entity_name detval_name
                                 with non-unique sorted key bo components root_name.

    data pending_det_on_mod_instances type tt_job_params.
    data root_name type abp_root_entity_name.

    data val_active type sap_bool.
    data val_active_draft type sap_bool.
    data det_on_save_active type sap_bool.
    data bo_stack type ref to lcl_bo_stack. "for on modify determinations

    types: begin of enum t_dump_kind base type i,
      cds_metadata_missing           value -2,
      invalid_parameter              value -1,
      internal_error                 value is initial,
      modify_in_validation           value 1,
      det_act_not_permitted          value 2,
      cross_bo_modify_cycle_in_det   value 4,
      endless_on_save                value 5,
"      mutual_on_modify_det           value 6,
      endless_on_modify              value 7,
      draft_by_eml                   value 8,
      det_on_save_not_complete       value 9,
    end of enum t_dump_kind.
    methods get_dump_message
      importing
        kind type t_dump_kind optional
      exporting
        msg_str       type string
      returning
        value(is_internal) type sap_bool.
    methods dump
      importing
        kind              type t_dump_kind optional
        culprit_root_name type abp_root_entity_name optional
        info              type string optional
        preferred parameter kind.

    methods add_determination
      importing entity_name        type abp_entity_name
                determination_name type abp_detval_name
                value(instances)   type abp_behv_trigger_instances_tab
                value(djob)        type ref to cl_abap_behv_djob.

    methods add_validation
      importing entity_name       type abp_entity_name
                validation_name   type abp_detval_name
                value(instances)  type abp_behv_trigger_instances_tab
                value(vjob)       type ref to cl_abap_behv_vjob.

  private section.
    data cache type ref to lcl_load_cache.
    data bo_trees type ref to lcl_bo_trees. "for determine actions
    data buffer type ref to lcl_buffer.     "for save sequence and determine actions
    data detact_buffer type ref to lcl_detact_buffer.

    methods _evaluate_field_triggers_det
      importing root_name    type abp_root_entity_name
                entity_name  type abp_entity_name
                det_name     type abp_detval_name
                triggers     type cl_abap_behv_load=>tt_detval_dvm_trigger
                instances    type any table
      returning value(tab_ref) type ref to data.
    methods evaluate_cud_triggers_det
      importing entity_name  type abp_entity_name
                det_name     type abp_detval_name
                triggers     type cl_abap_behv_load=>tt_detval_dvm_trigger
                operation    type char1
                instances    type any table
      returning value(tab_ref) type ref to data.
    methods evaluate_triggers
      importing root_name     type abp_root_entity_name
                entity_name   type abp_entity_name
                operation     type char1
                instances     type any table
                for_eml       type abap_bool
                in_local_mode type xsdboolean
      changing  load          type lcl_load_cache=>tt_detval_load_cache.
    methods exec_job
      importing job type ref to cl_abap_behv_job_base
                kind type abp_behv_kind.
    types: begin of t_det_action_instances,
      entity_name type abp_entity_name,
      instances type ref to data,
      t type i,
    end of t_det_action_instances.
    types: tt_det_action_instances type hashed table of t_det_action_instances with unique key entity_name.
    methods navigate_instances
      importing from type abp_entity_name
                to   type abp_entity_name
                instances type ref to data
      changing  cache type tt_det_action_instances
      returning value(to_instances) type ref to data.
    methods navigate_instances_detval
      importing from type abp_entity_name
                to   type abp_entity_name
                instances type ref to data
                op type abp_behv_op
                detval_name type abp_detval_name
      changing  cache type tt_det_action_instances
      returning value(res_instances) type ref to data.

    methods get_existing_instances
      importing root_name    type abp_root_entity_name
                entity_name  type abp_entity_name
                instances    type ref to data
                log          type ref to if_abap_behv_log
                is_draft     type sap_bool
                det_act_name type cl_abap_behv_job_base=>t_sub_name
      exporting value(has_draft) type sap_bool
      returning value(existing_instances) type ref to data.

    methods init_control
      importing entity_name type abp_entity_name
      changing tab type index table.

    methods get_instances_all
      importing load type cl_abap_behv_load=>t_detval_dvm
                instances type ref to data
      returning value(parameters) type ref to data.

    constants max_det_on_save_exec_count type i value 20.
    types: begin of t_det_exec,
             det_tabix type i,
             exec_count  type i,
             exec_t type i,
             id type int2,
             ic type int2,
             im type int2,
             always_flag type x length 1,
    end of t_det_exec.
    types tt_det_exec type standard table of t_det_exec with empty key.
    types: begin of t_det_execs,
      root_name type abp_root_entity_name,
      load_ref type ref to lcl_load_cache=>tt_detval_load_cache,
      det_exec type tt_det_exec,
    end of t_det_execs.
    types tt_det_execs type hashed table of t_det_execs with unique key root_name.
    data det_on_save_exec_ctx type tt_det_execs. "context during finalize, which in particular contains the last execution times
                                                 "exec_t of determinations. These times are reused when exec_determinations_on_save
                                                 "is called more than once during finalize.

    methods endless_on_save_dump
      importing
        culprit_root_name type abp_root_entity_name
        det_exec          type tt_det_exec.
endclass.

