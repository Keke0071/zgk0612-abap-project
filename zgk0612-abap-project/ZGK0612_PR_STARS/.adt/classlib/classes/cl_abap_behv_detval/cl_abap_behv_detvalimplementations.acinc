endclass.

class lcl_dvm_log definition final.
  public section.
    interfaces if_abap_behv_log.
    methods constructor
      importing reported_log type ref to if_abap_behv_log
                failed_log type ref to if_abap_behv_log optional
                late_response type sap_bool.
  private section.
    data late_response type sap_bool.
    data reported_log type ref to if_abap_behv_log.
    data failed_log type ref to if_abap_behv_log.
endclass.

class lcl_dvm_log implementation.
  method constructor.
    me->reported_log  = reported_log.
    me->failed_log    = failed_log.
    me->late_response = late_response.
  endmethod.
  method if_abap_behv_log~add.
    data(is_reported) = xsdbool( kind eq if_abap_behv_log=>reported or
                                 kind eq if_abap_behv_log=>reported_late ).
    assert is_reported eq abap_true or
           kind eq if_abap_behv_log=>failed or
           kind eq if_abap_behv_log=>failed_late.
    data(dst_log) = cond #( when is_reported eq abap_true then reported_log else failed_log ).
    if dst_log is not initial.
      data(is_late) = xsdbool( kind eq if_abap_behv_log=>failed_late or
                               kind eq if_abap_behv_log=>reported_late ).
      if is_late eq late_response.
        dst_log->add( kind         = kind
                      root_name    = root_name
                      entity_name  = entity_name
                      instances    = instances
                      entity_index = entity_index
                      flavor       = flavor ).
      else.
        field-symbols <new_instances> type any table.
        if is_reported eq abap_true.
          if late_response eq abap_true.
            data(new_kind) = if_abap_behv_log=>reported_late.
            data(new_op)   = cl_abap_behvdescr=>op_reported_late.
          else.
            new_kind = if_abap_behv_log=>reported.
            new_op   = cl_abap_behvdescr=>op_reported.
          endif.
        else.
          if late_response eq abap_true.
            new_kind = if_abap_behv_log=>failed_late.
            new_op   = cl_abap_behvdescr=>op_failed_late.
          else.
            new_kind = if_abap_behv_log=>failed.
            new_op   = cl_abap_behvdescr=>op_failed.
          endif.
        endif.
        if entity_index is not initial.
          data(new_inst_ref) = cl_abap_behvdescr=>create_data( p_root = root_name "omit entity_name here (compare VER52077)
                                                               p_op   = new_op ).
          assign new_inst_ref->* to field-symbol(<inst_stru>).
          assign component entity_index of structure <inst_stru> to <new_instances>.
        else.
          new_inst_ref = cl_abap_behvdescr=>create_data( p_root = root_name
                                                         p_name = entity_name
                                                         p_op   = new_op ).
          assign new_inst_ref->* to <new_instances>.
        endif.
        <new_instances> = corresponding #( deep instances ).
        dst_log->add( kind         = new_kind
                      root_name    = root_name
                      entity_name  = entity_name
                      instances    = <new_instances>
                      entity_index = entity_index
                      flavor       = flavor ).
      endif.
    endif.
  endmethod.

endclass.

