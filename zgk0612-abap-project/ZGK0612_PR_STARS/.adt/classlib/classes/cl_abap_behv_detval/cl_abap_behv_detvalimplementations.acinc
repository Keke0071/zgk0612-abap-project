    methods if_abap_behv_detval~exec_determinations_on_save redefinition.
    methods if_abap_behv_detval~exec_determinations_on_modify redefinition.
    methods if_abap_behv_detval~exec_validations redefinition.
    methods if_abap_behv_detval~exec_determine_action redefinition.
    methods if_abap_behv_detval~cleanup redefinition.

    constants c_xtrace_essential type if_sxt_types=>ty_trace_level value if_sxt_constants=>co_trace_level-essential_information.
    constants c_xtrace_extended type if_sxt_types=>ty_trace_level value if_sxt_constants=>co_trace_level-extended_information.
    constants c_xtrace_expert type if_sxt_types=>ty_trace_level value if_sxt_constants=>co_trace_level-expert_information.
    constants c_xtrace_verbose type if_sxt_types=>ty_trace_level value if_sxt_constants=>co_trace_level-verbose_information.

  protected section.
    methods dump redefinition.
    methods dump_xtrace
      importing
        kind type t_dump_kind.

    constants c_sxt_comp_dvm type if_sxt_types=>ty_component value 'SAP.BC.BEHV.DVM'.
    data sxt_tracer type ref to if_sxt_tracer.
    data sxt_trace_level type if_sxt_types=>ty_trace_level.

    methods add_determination redefinition.
    methods add_validation redefinition.

  private section.
    methods trace_beg_add_change_notif_tab
      importing changes type cl_abap_behv_detval=>tt_cud_instances
                for_eml type sap_bool.
    methods trace_beg_exec_detval
      importing params    type lcl_detval=>tt_job_params optional
                root_name type abp_root_entity_name
                proc_name type if_sxt_types=>ty_procedure
      returning value(hierarchy_number) type if_sxt_types=>ty_hierarchy_number.
    methods trace_end_exec_detval
      importing
        hierarchy_number type if_sxt_types=>ty_hierarchy_number.
    methods trace_beg_exec_da
      importing params       type ref to data
                entity_name  type abp_entity_name
                det_act_name type cl_abap_behv_job_base=>t_sub_name
      returning value(hierarchy_number) type if_sxt_types=>ty_hierarchy_number.
    methods trace_end_exec_da
      importing
        hierarchy_number type if_sxt_types=>ty_hierarchy_number.
endclass.

class lcl_buffer implementation.
  method cleanup.
    clear buffer.
    clear final_exec.
    add_call_count = 1.
  endmethod.
  method get_nr_of_key_comps.
    read table buffer with table key entity_name = entity_name assigning field-symbol(<entity_buffer>).
    if sy-subrc ne 0.
      create_entity_buffer( entity_name ).
      read table buffer with table key entity_name = entity_name assigning <entity_buffer>.
      assert sy-subrc eq 0.
    endif.
    key_comps = <entity_buffer>-key_comps.
  endmethod.
  method read_draft_persistency.
    data(head) = load_cache->get_load_head( entity_name ).
    if head-draftkind eq cl_abap_behv_load=>c_draftkind_bopf.
      data(draft_reader) = /bobf/cl_behv_handler_factory=>get_draft_changes_reader( entity_name ).
    else.
      draft_reader = cl_csp_dvm_ctrl_flag_read_fact=>get_draft_control_flag_reader( entity_name ).
    endif.
    read_draft_persistency0( entity_name = entity_name instances = instances draft_reader = draft_reader ).
  endmethod.
  method read_draft_persistency0.
    field-symbols <inst_tab> type index table.
    field-symbols <pky_tab> type index table.
    data pky_tab_ref type ref to data.
    assign instances->* to <inst_tab>.
    if <inst_tab> is not initial.
      read table buffer with table key entity_name = entity_name assigning field-symbol(<entity_buffer>).
      if sy-subrc ne 0.
        create_entity_buffer( entity_name ).
        read table buffer with table key entity_name = entity_name assigning <entity_buffer>.
        assert sy-subrc eq 0.
      endif.
      assign <entity_buffer>-header_line->* to field-symbol(<buffer_line>).
      assign component 1 of structure <buffer_line> to field-symbol(<buffer_change>).
      assign component '%CONTROL' of structure <buffer_change> to field-symbol(<ctrl>).
      assign component '%TKY' of structure <buffer_change> to field-symbol(<tky>).
      assign component '%IS_DRAFT' of structure <tky> to field-symbol(<is_draft>).
      assign component 2 of structure <buffer_line> to field-symbol(<buffer_operation>).
      assign component 3 of structure <buffer_line> to field-symbol(<buffer_t>).
      assign component 4 of structure <buffer_line> to field-symbol(<buffer_t0>).
      assign <entity_buffer>-ctrl->* to field-symbol(<ctrl_std>).
      clear <buffer_t0>.
      field-symbols <buffer_state> type any table.
      assign <entity_buffer>-state->* to <buffer_state>.
      read table <inst_tab> index 1 assigning field-symbol(<inst1>).
      pky_tab_ref = cl_abap_behvdescr=>create_data( p_name = entity_name p_op = cl_abap_behvdescr=>op_virtual_pkey ).
      assign pky_tab_ref->* to <pky_tab>.
      <is_draft> = if_abap_behv=>mk-on.
      loop at <inst_tab> assigning field-symbol(<inst>).
        move-corresponding <inst> to <tky>.
        read table <buffer_state> from <buffer_line> assigning field-symbol(<buffer_item>).
        if sy-subrc eq 0.
          assign component 'OPERATION' of structure <buffer_item> to field-symbol(<buffer_op>).
          if if_abap_behv=>op-m-update ne <buffer_op>.
            continue. "the content of the draft persistency is not important in that case
          endif.
        endif.
        insert initial line into table <pky_tab> assigning field-symbol(<pky>).
        move-corresponding <inst> to <pky>.
      endloop.
      if <pky_tab> is initial.
        return.
      endif.
      data(create_tab_ref) = cl_abap_behvdescr=>create_data( p_name = entity_name p_op = cl_abap_behvdescr=>op_notifications ).
      data(update_tab_ref) = cl_abap_behvdescr=>create_data( p_name = entity_name p_op = cl_abap_behvdescr=>op_notifications ).
      data(delete_tab_ref) = cl_abap_behvdescr=>create_data( p_name = entity_name p_op = cl_abap_behvdescr=>op_virtual_pkey ).
      field-symbols <create_tab> type index table.
      field-symbols <update_tab> type index table.
      field-symbols <delete_tab> type index table.
      assign create_tab_ref->* to <create_tab>.
      assign update_tab_ref->* to <update_tab>.
      assign delete_tab_ref->* to <delete_tab>.
      draft_reader->get_persisted_draft_changes( exporting pky_tab = <pky_tab>
                                                 importing create_tab = <create_tab>
                                                           update_tab = <update_tab>
                                                           delete_tab = <delete_tab> ).
      assert <delete_tab> is initial.
      if lines( <create_tab> ) + lines( <update_tab> ) ne lines( <pky_tab> ).
        "cache UnFound Objects
        "1. remove keys that have draft entries
        data(pky_ref) = cl_abap_behvdescr=>create_data( p_name = entity_name p_op = cl_abap_behvdescr=>op_virtual_pkey p_structure = abap_true ).
        assign pky_ref->* to <pky>.
        assign component '%PID' of structure <pky> to field-symbol(<tst>).
        if sy-subrc eq 0.
          data(key_name) = `PID`.
        else.
          key_name = `ENTITY`.
        endif.
        loop at <create_tab> assigning <inst>.
          move-corresponding <inst> to <pky>.
          delete table <pky_tab> from <pky> using key (key_name).
        endloop.
        loop at <update_tab> assigning <inst>.
          move-corresponding <inst> to <pky>.
          delete table <pky_tab> from <pky> using key (key_name).
        endloop.
        "2. cache keys that have unchanged draft entries
        clear <buffer_line>.
        <is_draft> = if_abap_behv=>mk-on.
        <buffer_operation> = op_unchanged_draft.
        clear <buffer_t>.
        loop at <pky_tab> assigning <pky>.
          move-corresponding <pky> to <tky>.
          read table <buffer_state> from <buffer_line> assigning <buffer_item>.
          if sy-subrc ne 0.
            insert <buffer_line> into table <buffer_state>.
          else.
            assign component 'OPERATION' of structure <buffer_item> to <buffer_op>.
            if <buffer_op> eq cl_abap_behv_detval=>op-update.
              <buffer_op> = op_update_draft_read.
            endif.
          endif.
        endloop.
      endif.
      loop at <create_tab> assigning <inst>.
        assign component '%CONTROL' of structure <inst> to field-symbol(<inst_ctrl>).
        assign component '%TKY' of structure <inst> to field-symbol(<inst_tky>).
        <tky> = <inst_tky>.
        read table <buffer_state> from <buffer_line> assigning <buffer_item>.
        if sy-subrc eq 0.
          assign component 'OPERATION' of structure <buffer_item> to field-symbol(<buffer_item_op>).
          <buffer_item_op> = if_abap_behv=>op-m-create.
          assign component 4 of structure <buffer_item> to field-symbol(<buffer_item_t0>).
          <buffer_item_t0> = 1.
          assign component 'CHANGE-%CONTROL' of structure <buffer_item> to field-symbol(<buffer_ctrl>).
          merge_with_draft_control( exporting ctrl_draft = <inst_ctrl> changing ctrl = <buffer_ctrl> ).
        else.
          clear <ctrl>.
          merge_with_draft_control( exporting ctrl_draft = <inst_ctrl> changing ctrl = <ctrl> ).
          <buffer_t> = 1.
          <buffer_operation> = cl_abap_behv_detval=>op-create.
          <buffer_t0> = 1.
          insert <buffer_line> into table <buffer_state>.
        endif.
      endloop.
      loop at <update_tab> assigning <inst>.
        assign component '%CONTROL' of structure <inst> to <inst_ctrl>.
        assign component '%TKY' of structure <inst> to <inst_tky>.
        <tky> = <inst_tky>.
        read table <buffer_state> from <buffer_line> assigning <buffer_item>.
        if sy-subrc eq 0.
          assign component 'OPERATION' of structure <buffer_item> to <buffer_item_op>.
          <buffer_item_op> = op_update_draft_read.
          assign component 'CHANGE-%CONTROL' of structure <buffer_item> to <buffer_ctrl>.
          merge_with_draft_control( exporting ctrl_draft = <inst_ctrl> changing ctrl = <buffer_ctrl> ).
        else.
          clear <ctrl>.
          merge_with_draft_control( exporting ctrl_draft = <inst_ctrl> changing ctrl = <ctrl> ).
          <buffer_t> = 1.
          <buffer_operation> = op_update_draft_read.
          <buffer_t0> = 0.
          insert <buffer_line> into table <buffer_state>.
        endif.
      endloop.
    endif.
  endmethod.
  method triggers.
    assign component 3 of structure buffer_item to field-symbol(<t>).
    if <t> <= last_t.
      return.
    endif.
    assign component 2 of structure buffer_item to field-symbol(<op>).
    if <op> eq op_unchanged_draft or <op> eq cl_abap_behv_detval=>op-discard.
      return.
    endif.
    loop at triggers assigning field-symbol(<trigger>).
      if <trigger>-op eq cl_abap_behv_load=>c_trigger_field.
        if <op> ne cl_abap_behv_detval=>op-delete.
          assign component 'CHANGE-%CONTROL' of structure buffer_item to field-symbol(<buffer_ctrl>).
          assign component <trigger>-element of structure <buffer_ctrl> to field-symbol(<field>).
          if <field> > last_t.
            flag = 'X'.
            return.
          endif.
        endif.
      else.
        if ( <op> eq <trigger>-op and <trigger>-op ne cl_abap_behv_load=>c_trigger_create ) or
           ( <op> eq op_update_draft_read and <trigger>-op eq cl_abap_behv_load=>c_trigger_update ).
          flag = 'X'.
          return.
        elseif <op> eq cl_abap_behv_load=>c_trigger_create and
               <trigger>-op ne cl_abap_behv_load=>c_trigger_delete."update or create
          assign component 4 of structure buffer_item to field-symbol(<t0>).
          if not ( ( <t0> <= last_t and <trigger>-op eq cl_abap_behv_load=>c_trigger_create ) or
                   ( <t> eq <t0> and <trigger>-op eq cl_abap_behv_load=>c_trigger_update ) ).
            flag = 'X'.
            return.
          endif.
        endif.
      endif.
    endloop.
  endmethod.
  method get_instances_filtered.
    field-symbols <filter> type any table.
    assign filter->* to <filter>.
    read table buffer with table key entity_name = load-owner_entity assigning field-symbol(<ebuffer>).
    if sy-subrc ne 0.
      if has_draft eq abap_false.
        return.
      endif.
      read_draft_persistency( entity_name = load-owner_entity instances = filter ).
      read table buffer with table key entity_name = load-owner_entity assigning <ebuffer>.
      if sy-subrc ne 0.
        return. "no relevant changes
      endif.
    endif.
    field-symbols <buffer_state> type any table.
    assign <ebuffer>-state->* to <buffer_state>.
    assign <ebuffer>-header_line->* to field-symbol(<buffer_read>).
    assign component 'CHANGE-%TKY' of structure <buffer_read> to field-symbol(<buffer_read_tky>).
    loop at <filter> assigning field-symbol(<filter_item>).
      assign component '%TKY' of structure <filter_item> to field-symbol(<filter_tky>).
      <buffer_read_tky> = <filter_tky>.
      read table <buffer_state> from <buffer_read> assigning field-symbol(<buffer_item>).
      if sy-subrc ne 0 and has_draft eq abap_true and last_t eq 0.
        read_draft_persistency( entity_name = load-owner_entity instances = filter ).
        <buffer_read_tky> = <filter_tky>. "may be overwritten by read_draft_persistency
        read table <buffer_state> from <buffer_read> assigning <buffer_item>.
      endif.
      if sy-subrc eq 0.
        assign component 'OPERATION' of structure <buffer_item> to field-symbol(<op>).
        assert sy-subrc eq 0.
        if <op> eq if_abap_behv=>op-m-update and has_draft eq abap_true and last_t eq 0.
          "<op> should either be create or op_update_draft_read in that case
          read_draft_persistency( entity_name = load-owner_entity instances = filter ).
        endif.
        if triggers( triggers = load-triggers buffer_item = <buffer_item> last_t = last_t ) eq abap_true.
          insert_instance( exporting load = load tky = <filter_tky> changing instances = instances ).
        endif.
      endif.
    endloop.
  endmethod.
  method get_instances_for_always.
    data has_delete_trigger type abap_bool value abap_undefined.
    field-symbols <filter> type any table.
    assign filter->* to <filter>.
    read table buffer with table key entity_name = load-owner_entity assigning field-symbol(<ebuffer>).
    if sy-subrc ne 0.
      return. "no relevant changes
    endif.
    field-symbols <buffer_state> type any table.
    assign <ebuffer>-state->* to <buffer_state>.
    assign <ebuffer>-header_line->* to field-symbol(<buffer_read>).
    assign component 'CHANGE-%TKY' of structure <buffer_read> to field-symbol(<buffer_read_tky>).
    loop at <filter> assigning field-symbol(<filter_item>).
      assign component '%TKY' of structure <filter_item> to field-symbol(<filter_tky>).
      <buffer_read_tky> = <filter_tky>.
      read table <buffer_state> from <buffer_read> assigning field-symbol(<buffer_item>).
      if sy-subrc eq 0.
        assign component 'OPERATION' of structure <buffer_item> to field-symbol(<op>).
        assert sy-subrc eq 0.
        if <op> eq if_abap_behv=>op-m-update or "check existence
           <op> eq if_abap_behv=>op-m-create or
           <op> eq op_update_draft_read.
          insert_instance( exporting load = load tky = <filter_tky> changing instances = instances ).
        elseif <op> eq if_abap_behv=>op-m-delete.
          if has_delete_trigger eq abap_undefined.
            has_delete_trigger = abap_false.
            loop at load-triggers assigning field-symbol(<trigger>).
              if <trigger>-op eq if_abap_behv=>op-m-delete.
                has_delete_trigger = abap_true.
                exit.
              endif.
            endloop.
          endif.
          if has_delete_trigger eq abap_true.
            insert_instance( exporting load = load tky = <filter_tky> changing instances = instances ).
          endif.
        endif.
      else.
        "unchanged instances exist in this case (has been checked before)
        insert_instance( exporting load = load tky = <filter_tky> changing instances = instances ).
      endif.
    endloop.
  endmethod.
  method insert_instance.
    field-symbols <instances> type any table.
    if instances is initial.
      instances = cl_abap_behvdescr=>create_data( p_name = load-owner_entity
                                                    p_op = cond #( when load-kind eq 'V'
                                                                     then cl_abap_behvdescr=>op_validate
                                                                     else cl_abap_behvdescr=>op_determine )
                                                    p_sub_name = load-name ).
    endif.
    assign instances->* to <instances>.
    insert initial line into table <instances> assigning field-symbol(<instance>). "<instances> has empty key
    move-corresponding tky to <instance>.
  endmethod.
  method get_instances.
    read table buffer with table key entity_name = load-owner_entity assigning field-symbol(<ebuffer>).
    if sy-subrc ne 0 or <ebuffer>-last_change_t <= last_t.
      return. "no relevant changes
    endif.
    field-symbols <buffer_state> type any table.
    assign <ebuffer>-state->* to <buffer_state>.
    if <buffer_state> is initial.
      return. "no relevant changes
    endif.
    instances = _get_instances( buffer_state     = <buffer_state>
                                root_name        = root_name
                                load             = load
                                last_t           = last_t ).
  endmethod.
  method _get_instances by kernel module ab_km_dvm_get_instances fail.
*    field-symbols <buffer_state> type any table.
*    assign buffer_state_ref->* to <buffer_state>.
*    if with_draft eq abap_false. "with_draft is determined in kernel method
*      data(where_cond) = `T > LAST_T`.
*    else.
*      where_cond = `T > LAST_T AND CHANGE-%IS_DRAFT IS INITIAL`.
*    endif.
*    loop at <buffer_state> assigning field-symbol(<buffer_item>) where (where_cond).
*      if triggers( triggers = load-triggers buffer_item = <buffer_item> last_t = last_t ) eq abap_true.
*        assign component 'CHANGE-%TKY' of structure <buffer_tiem> to field-symbol(<tky>).
*        insert_instance( exporting load = load tky = <tky> changing instances = instances ).
*      endif.
*    endloop.
  endmethod.
  method add_change_notification_tab.
    field-symbols <buffer_state> type any table.
    field-symbols <change_tab> type any table.
    add_call_count += 1.
    loop at changes assigning field-symbol(<change>).
      read table buffer with table key entity_name = <change>-entity_name assigning field-symbol(<entity_buffer>).
      if sy-subrc ne 0.
        create_entity_buffer( <change>-entity_name ).
        read table buffer with table key entity_name = <change>-entity_name assigning <entity_buffer>.
        assert sy-subrc eq 0.
      endif.
      <entity_buffer>-last_change_t = add_call_count.

      set_final_exec_t( root_name = <entity_buffer>-root_name final_exec_t = add_call_count ).
      assign <entity_buffer>-state->* to <buffer_state>.
      assign <entity_buffer>-header_line->* to field-symbol(<buffer_line>).
      assign component 1 of structure <buffer_line> to field-symbol(<buffer_change>).
      assign component '%TKY' of structure <buffer_change> to field-symbol(<buffer_change_tky>).
      data(chk_draft) = abap_false.
      if for_eml eq 'X'.
        assign component '%IS_DRAFT' of structure <buffer_change_tky> to field-symbol(<is_draft>).
        if sy-subrc eq 0.
          chk_draft = abap_true.
        endif.
      endif.
      assign component '%CONTROL' of structure <buffer_change> to field-symbol(<buffer_change_ctrl>).
      assign component 2 of structure <buffer_line> to field-symbol(<buffer_operation>).
      assign component 3 of structure <buffer_line> to field-symbol(<buffer_t>).
      assign component 4 of structure <buffer_line> to field-symbol(<buffer_t0>).
      <buffer_operation> = <change>-operation.
      <buffer_t> = add_call_count.
      assign <change>-instances->* to <change_tab>.
      loop at <change_tab> assigning field-symbol(<change_item>).
        assign component '%TKY' of structure <change_item> to field-symbol(<change_item_tky>).
        <buffer_change_tky> = <change_item_tky>.
        if chk_draft eq abap_true and <is_draft> is not initial.
          raise exception type lcx_draft_not_permitted.
        endif.
        read table <buffer_state> from <buffer_line> assigning field-symbol(<buffer_item>).
        if sy-subrc ne 0.
          clear <buffer_change_ctrl>.
          if <change>-operation eq if_abap_behv=>op-m-create.
            <buffer_t0> = add_call_count.
          else.
            clear <buffer_t0>.
          endif.
          if <change>-operation eq if_abap_behv=>op-m-create or
             <change>-operation eq if_abap_behv=>op-m-update.
            assign component '%CONTROL' of structure <change_item> to field-symbol(<change_item_ctrl>).
            _merge_controls( exporting ctrl1          = <change_item_ctrl>
                                       add_call_count = add_call_count
                              changing ctrl2          = <buffer_change_ctrl> ).
          endif.
          insert <buffer_line> into table <buffer_state>.
        else.
          assign component 'CHANGE-%CONTROL' of structure <buffer_item> to field-symbol(<buffer_item_change_ctrl>).
          assign component 2 of structure <buffer_item> to field-symbol(<buffer_item_operation>).
          assign component 3 of structure <buffer_item> to field-symbol(<buffer_item_t>).
          <buffer_item_t> = add_call_count.
          case <change>-operation.
            when if_abap_behv=>op-m-delete.
              <buffer_item_operation> = if_abap_behv=>op-m-delete.
              clear <buffer_item_change_ctrl>.
            when if_abap_behv=>op-m-create.
              assert <buffer_item_operation> ne if_abap_behv=>op-m-update and
                     <buffer_item_operation> ne op_update_draft_read.
              assign component 4 of structure <buffer_item> to field-symbol(<buffer_item_t0>).
              <buffer_item_t0> = add_call_count.
              <buffer_item_operation> = if_abap_behv=>op-m-create.
                assign component '%CONTROL' of structure <change_item> to <change_item_ctrl>.
                _merge_controls( exporting ctrl1          = <change_item_ctrl>
                                           add_call_count = add_call_count
                                  changing ctrl2          = <buffer_item_change_ctrl> ).
            when if_abap_behv=>op-m-update.
              assert <buffer_item_operation> ne if_abap_behv=>op-m-delete.
              if <buffer_item_operation> eq op_unchanged_draft.
                <buffer_item_operation> = op_update_draft_read.
              endif.
              "keep component 4 of <buffer_item>
                assign component '%CONTROL' of structure <change_item> to <change_item_ctrl>.
                _merge_controls( exporting ctrl1          = <change_item_ctrl>
                                           add_call_count = add_call_count
                                  changing ctrl2          = <buffer_item_change_ctrl> ).
            when cl_abap_behv_detval=>op-discard.
              <buffer_item_operation> = cl_abap_behv_detval=>op-discard.
              clear <buffer_item_change_ctrl>.
          endcase.
        endif.
      endloop.
    endloop.
  endmethod.
  method _merge_controls by kernel module ab_km_dvm_merge_controls fail.
*    do.
*      assign component sy-index of structure ctrl1 to field-symbol(<fs1>).
*      if sy-subrc ne 0.
*        return. "all components processed
*      endif.
*      if <fs1> is not initial.
*        assign component sy-index of structure ctrl2 to field-symbol(<fs2>).
*        <fs2> = add_call_count.
*      endif.
*    enddo.
  endmethod.
  method merge_with_draft_control.
    do.
      assign component sy-index of structure ctrl to field-symbol(<fs>).
      if sy-subrc ne 0.
        return. "all components processed
      endif.
      if <fs> is initial.
        assign component sy-index of structure ctrl_draft to field-symbol(<fs_draft>).
        if <fs_draft> is not initial.
          <fs> = 1.
        endif.
      endif.
    enddo.
  endmethod.
  method create_entity_buffer.
    data(flags) = load_cache->get_flags( entity_name ).
"    if flags is initial.
"      insert value #( entity_name = entity_name )
"        into table buffer.
"      return.
"    endif.

    data(root_name) = cl_abap_behvdescr=>get_root( entity_name ).
    data(buffer_type_name) = |\\BDEF={ root_name }\\ENTITY={ entity_name }\\TYPE=DVMBUFFER|.
    data(td) = cast cl_abap_tabledescr( cl_abap_typedescr=>describe_by_name( buffer_type_name ) ).
    data(sd) = td->get_table_line_type( ).
    data(change_type) = cast cl_abap_structdescr(
                        cl_abap_behvdescr=>get_type( p_name      = entity_name
                                                     p_op        = cl_abap_behvdescr=>op_notifications
                                                     p_structure = 'X' ) ).
    data(control_type) = change_type->get_component_type( '%CONTROL' ).
    "create data
    data state type ref to data.
    data header_line type ref to data.
    data ctrl_std type ref to data.
    create data state type handle td.
    create data header_line type handle sd.
    create data ctrl_std type handle control_type.
    data(has_is_draft) = abap_false.
    read table change_type->components with table key name = '%IS_DRAFT' transporting no fields.
    if sy-subrc eq 0.
      has_is_draft = abap_true.
    endif.
    assign component 'CHANGE-%KEY' of structure header_line->* to field-symbol(<key>).
    data type_dummy type c length 1 ##NEEDED.
    data key_comps type i.
    describe field <key> type type_dummy components key_comps.
    insert value #( entity_name       = entity_name
                    root_name         = root_name
                    state             = state
                    header_line       = header_line
                    with_draft        = has_is_draft
                    has_on_mod        = xsdbool( ( flags bit-and lcl_detval=>flag_has_on_mod ) ne lcl_detval=>flags_none )
                    ctrl              = ctrl_std
                    key_comps         = key_comps )
      into table buffer.
  endmethod.

  method constructor.
    me->load_cache = load_cache.
  endmethod.

  method get_final_exec_t.
    read table final_exec with table key root_name = root_name into data(wa) transporting final_exec_t.
    final_exec_t = wa-final_exec_t. "0 if not found
  endmethod.

  method set_final_exec_t.
    read table final_exec with table key root_name = root_name assigning field-symbol(<fs>).
    if sy-subrc eq 0.
      <fs>-final_exec_t = final_exec_t.
    else.
      insert value #( root_name = root_name final_exec_t = final_exec_t ) into table final_exec.
    endif.
  endmethod.

  method read_control_flags.
    read table buffer with table key entity_name = entity_name assigning field-symbol(<entity_buffer>).
    if sy-subrc ne 0.
      return. "entity not in buffer -> nothing to do
    endif.
    assign <entity_buffer>-header_line->* to field-symbol(<buffer_line>).
    assign component 1 of structure <buffer_line> to field-symbol(<buffer_change>).
    assign component '%TKY' of structure <buffer_change> to field-symbol(<tky>).
    field-symbols <buffer_state> type any table.
    assign <entity_buffer>-state->* to <buffer_state>.

    "step 1: collect draft keys with operation update in buffer to call read_draft_persistency
    data update_keys type ref to data.
    update_keys = cl_abap_behvdescr=>create_data( p_name = entity_name p_op = cl_abap_behvdescr=>op_virtual_tkey ).
    field-symbols <update_keys> type index table.
    assign update_keys->* to <update_keys>.
    loop at keys assigning field-symbol(<key>).
      assign component '%IS_DRAFT' of structure <key> to field-symbol(<is_draft>).
      if sy-subrc ne 0.
        exit.
      endif.
      if <is_draft> is initial.
        continue.
      endif.
      move-corresponding <key> to <tky>.
      read table <buffer_state> from <buffer_line> assigning field-symbol(<buffer_item>).
      if sy-subrc eq 0.
        assign component 'OPERATION' of structure <buffer_item> to field-symbol(<buffer_op>).
        if if_abap_behv=>op-m-update eq <buffer_op>.
          append initial line to <update_keys> assigning field-symbol(<new_update_key>).
          move-corresponding <key> to <new_update_key>.
        endif.
      endif.
    endloop.
    if <update_keys> is not initial.
      read_draft_persistency( entity_name = entity_name
                              instances   = update_keys ).
    endif.

    "step 2: transform flags of keys in buffer
    control_flags = cl_abap_behvdescr=>create_data( p_name = entity_name p_op = cl_abap_behvdescr=>op_notifications ).
    field-symbols <control_flags> type index table.
    assign control_flags->* to <control_flags>.

    loop at keys assigning <key>.
      move-corresponding <key> to <tky>.
      read table <buffer_state> from <buffer_line> assigning <buffer_item>.
      if sy-subrc ne 0.
        continue.
      endif.
      assign component 'OPERATION' of structure <buffer_item> to <buffer_op>.
      if if_abap_behv=>op-m-update eq <buffer_op> or "update may occur for active keys
         if_abap_behv=>op-m-create eq <buffer_op> or
         op_update_draft_read eq <buffer_op>.
        append initial line to <control_flags> assigning field-symbol(<control_flags_line>).
        move-corresponding <tky> to <control_flags_line>.
        assign component '%CONTROL' of structure <control_flags_line> to field-symbol(<control_flags_ctrl>).
        assign component 'CHANGE-%CONTROL' of structure <buffer_item> to field-symbol(<buffer_ctrl>).
        do.
          assign component sy-index of structure <buffer_ctrl> to field-symbol(<buffer_ctrl_field>).
          if sy-subrc ne 0.
            exit.
          endif.
          if <buffer_ctrl_field> > 0.
            assign component sy-index of structure <control_flags_ctrl> to field-symbol(<control_flags_ctrl_field>).
            assert sy-subrc eq 0.
            <control_flags_ctrl_field> = if_abap_behv=>mk-on.
          endif.
        enddo.
      endif.
    endloop.
  endmethod.


  method get_last_change_t.
    read table buffer with key entity_name = entity_name into data(wa) transporting last_change_t.
    if sy-subrc eq 0.
      return wa-last_change_t.
"   else.
"     return 0.
    endif.
  endmethod.

endclass.

class lcl_detval implementation.
  method constructor.
    cache = new lcl_load_cache( ).
    bo_trees = new lcl_bo_trees( ).
    buffer = new lcl_buffer( cache ).
    detact_buffer = new lcl_detact_buffer( buffer ).
    bo_stack = new lcl_bo_stack( ).
    if cl_feature_toggle=>is_active( if_rap_feature_toggle_ids=>c_incompatible_changes-ic_2311_det_act_opt ) is initial.
      is_optimization1_active = abap_true.
    endif.
  endmethod.

  method get_dump_message.
    data msgno type SCX_T100KEY-msgno.
    data msgv1 type string.
    case kind.
      when modify_in_validation.
        msgno = '000'. " Modify in validation not permitted
      when det_act_not_permitted.
        msgno = '001'. " Determine action calls not permitted in determinations and validations
"      when trigger_in_determination.
"        ...
*      when action_in_on_mod_det.
*        ...
      when cross_bo_modify_cycle_in_det.
        msgno = '002'. " Cyclic cross BO modifications not permitted in on modify determinations
        msgv1 = 'on modify determinations'  ##NO_TEXT.
"      when mutual_on_modify_det.
"        msgno = '005'. " On-modify Determinations of the same BO must not trigger each other mutually
"        msgv1 = 'On modify determinations'  ##NO_TEXT.
      when endless_on_save.
        msgno = '003'. " Endless loop because of cyclic triggering of on save determinations
      when endless_on_modify. " Stack of on modify determinations too deep for current bo
        msgno = '006'.
      when draft_by_eml.
        msgno = '007'.
      when det_on_save_not_complete.
        msgno = '008'.
        msgv1 = 'on save determinations'  ##NO_TEXT.
      when others.
        msgno = '004'. " Internal error
        is_internal = 'X'.
    endcase.
    MESSAGE ID 'SABP_BEHV_DVM' TYPE 'S' NUMBER msgno
      WITH msgv1
      INTO msg_str.
  endmethod.

  method dump.
    data is_internal type sap_bool.
    is_internal = get_dump_message( kind = kind ).
    " RAISE SHORTDUMP will use the message of the last MESSAGE statement.
    if is_internal is not initial.
      raise shortdump type lcx_abap_behv_detval_error using message
        exporting info = info.
    elseif culprit_root_name is initial.
      cl_abap_behv_detval=>dump( info ).
    else.
      data tadir_key type sabp_s_tadir_key.
      tadir_key-obj_type = 'BDEF'.
      tadir_key-obj_name = culprit_root_name.
      raise shortdump type lcx_abap_behv_detval_error using message
            exporting tadir_key = tadir_key
                      info      = info.
    endif.
  endmethod.

  method if_abap_behv_detval~add_change_notification_tab.
    field-symbols <itab> type any table.
    if val_active ne space.
      if val_active_draft ne space.
        dump( kind = modify_in_validation ).
        return. "for unit tests
      else.
        loop at changes assigning field-symbol(<change>).
          if <change>-operation ne cl_abap_behv_detval=>op-discard. "allow delayed discard notifications during validations on active instances
            dump( kind = modify_in_validation ).
            return. "for unit tests
          endif.
        endloop.
      endif.
    endif.
    try.
      buffer->add_change_notification_tab( changes = changes for_eml = for_eml ).
    catch lcx_draft_not_permitted.
      dump( draft_by_eml ).
    endtry.
    cl_abap_behv_aux=>get_current_context( importing draft_activate = data(draft_activate)
                                                     in_local_mode  = data(in_local_mode) ).
    if draft_activate is not initial and
      abap_true eq cl_abap_behv_detval=>is_activate_optimized( cl_abap_behvdescr=>get_root( changes[ 1 ]-entity_name ) ). "all entities belong to same bo here
      detact_buffer->activate( changes ).
      return. "no on modify determinations during activate (they have already been executed on draft instances)
    endif.
    loop at changes assigning <change>.
      data(flags) = cache->get_flags( <change>-entity_name ).
      if ( flags bit-and lcl_detval=>flag_has_on_mod ) ne lcl_detval=>flags_none and
        <change>-instances is not initial.
        data(load_ref) = cache->get_bo_load_ref( exporting entity = <change>-entity_name importing root_entity = root_name ).
        assign <change>-instances->* to <itab>.
        if <itab> is initial.
          continue.
        endif.
        case <change>-operation.
          when if_abap_behv=>op-m-create or
               if_abap_behv=>op-m-update or
               if_abap_behv=>op-m-delete.
            evaluate_triggers( exporting
                                 root_name     = root_name
                                 entity_name   = <change>-entity_name
                                 operation     = <change>-operation
                                 instances     = <itab>
                                 for_eml       = for_eml
                                 in_local_mode = in_local_mode
                               changing
                                 load          = load_ref->* ).
          when cl_abap_behv_detval=>op-discard.
            " discards are ignored for on modify determinations.
            " this is in accordance with the general requirement of "no aggregation" for on modify.
          when others.
            dump( invalid_parameter ).
        endcase.
      endif.
    endloop.
  endmethod.

  method _evaluate_field_triggers_det by kernel module ab_km_dvm_eval_field_triggers fail.
*    field-symbols <tab> type any table.
*    loop at instances assigning field-symbol(<instance>).
*      assign component '%CONTROL' of structure <instance> to field-symbol(<ctrl>).
*      assert sy-subrc eq 0.
*      loop at triggers assigning field-symbol(<trigger>) where op eq cl_abap_behv_load=>c_trigger_field.
*        assign component <trigger>-element of structure <ctrl> to field-symbol(<is_comp_triggered>).
*        assert sy-subrc eq 0.
*        if <is_comp_triggered> eq if_abap_behv=>mk-on.
*          if tab_ref is initial.
*            tab_ref = cl_abap_behvdescr=>create_data( p_root = root_name
*                                                      p_name = entity_name
*                                                      p_op = cl_abap_behvdescr=>op_determine
*                                                      p_sub_name = det_name ).
*            assign tab_ref->* to <tab>.
*          endif.
*          insert initial line into table <tab> assigning field-symbol(<param>). "<tab> has empty key
*          move-corresponding <instance> to <param>.
*          exit.
*        endif.
*      endloop.
*    endloop.
  endmethod.

  method evaluate_cud_triggers_det.
    field-symbols <tab> type any table.
    loop at triggers assigning field-symbol(<trigger>) where op ne cl_abap_behv_load=>c_trigger_field.
      if operation eq <trigger>-op.
        tab_ref = cl_abap_behvdescr=>create_data( p_name = entity_name
                                                  p_op = cl_abap_behvdescr=>op_determine
                                                  p_sub_name = det_name ).

        assign tab_ref->* to <tab>.
        move-corresponding instances to <tab>.
        return.
      endif.
    endloop.
  endmethod.

  method evaluate_triggers.
    field-symbols <tab1> type index table.
    field-symbols <tab2> type index table.
    data tab_ref type ref to data.
    loop at load assigning field-symbol(<load_line>) where exec_type = 'M' and owner_entity eq entity_name.
      clear tab_ref.
      if ( <load_line>-flags bit-and flag_draft_only ) ne flags_none and for_eml eq abap_true.
        "instances cannot be draft instances in this case (has been checked before)
        continue.
      endif.
      if ( <load_line>-flags bit-and flag_not_in_local_mode ) ne flags_none and in_local_mode is not initial.
        data act_bdef_id type i value -99.
        data act_extfrnd_grp type i.
        data act_root_name type abp_root_entity_name.
        call 'BEHV_EXEC' id 'OP' field 10
                id 'BDEF_ID' field act_bdef_id
                id 'EXTFRND_GRP' field act_extfrnd_grp
                id 'ROOT_NAME' field act_root_name.  "#EC CI_CCALL
        if act_bdef_id >= 0 and act_root_name eq root_name.
          if <load_line>-nilm_chk_extfrnd_grp < 0.
            if <load_line>-nilm_chk_extfrnd_grp eq -1.
              "no handler
              continue.
            endif.
            "init handler with det handler
            data(djob_det_handler) = cl_abap_behv_djob=>create(  ).
            djob_det_handler->add_determinations( entity_name        = <load_line>-owner_entity
                                                  determination_name = <load_line>-name
                                                  instances          = value #( ( ) ) ).
            cl_abap_behv_ctrl=>get_handlers(
              exporting job  = djob_det_handler
                        kind = 'D'
              importing handlers = data(handlers) ).
            if handlers is initial.
              <load_line>-nilm_chk_extfrnd_grp = -1. "skipped anyway
              continue.
            else.
              data(handler) = handlers[ 1 ]-handler.
              call 'BEHV_EXEC' id 'OP' field 11
                    id 'OBJ' field handler
                    id 'EXTFRND_GRP' field <load_line>-nilm_chk_extfrnd_grp.  "#EC CI_CCALL
            endif.
          endif.
          " Filter out handlers with the same extfrnd_grp as the running handler
          if <load_line>-nilm_chk_extfrnd_grp = act_extfrnd_grp.
            continue. "skip det
          endif.
        endif.
      endif.
      if ( <load_line>-flags bit-and flag_detval_has_cud_trigger ) ne flags_none.
        tab_ref = evaluate_cud_triggers_det( exporting entity_name = entity_name
                                                       det_name    = <load_line>-name
                                                       triggers    = <load_line>-triggers
                                                       operation   = operation
                                                       instances   = instances ).
      endif.
      if tab_ref is initial and
        ( <load_line>-flags bit-and flag_detval_has_field_trigger ) ne flags_none and
        operation ne if_abap_behv=>op-m-delete.
        tab_ref = _evaluate_field_triggers_det( exporting root_name   = root_name
                                                         entity_name = entity_name
                                                         det_name    = <load_line>-name
                                                         triggers    = <load_line>-triggers
                                                         instances   = instances ).
      endif.
      if tab_ref is not initial.
        read table pending_det_on_mod_instances with table key entity_name = entity_name
                                                               detval_name = <load_line>-name
                                                     assigning field-symbol(<inst>).
        if sy-subrc eq 0.
          assign <inst>-instances->* to <tab1>.
          assign tab_ref->* to <tab2>.
          append lines of <tab2> to <tab1>. "consider duplicates later
        else.
          insert value #( root_name   = root_name
                          entity_name = entity_name
                          detval_name = <load_line>-name
                          instances   = tab_ref ) into table pending_det_on_mod_instances.
        endif.
      endif.
    endloop.
  endmethod.

  method if_abap_behv_detval~exec_determinations_on_save.
    data rc type i.
    assert det_on_save_active is initial
       and bo_stack->stack is initial
       and val_active is initial.
    det_on_save_active = abap_true.
    read table det_on_save_exec_ctx with table key root_name = root_entity_name assigning field-symbol(<exec_ctx>).
    if sy-subrc ne 0.
      data(load_ref) = me->cache->get_bo_load_ref( root_entity_name ).
      data det_exec type tt_det_exec.
      data(impls) = cl_abap_behv_detval=>get_det_on_save_impls( exporting root_name = root_entity_name
                                                                importing rc = rc ).
      if not ( rc is initial or rc eq 4 ). "rc is "ok" or "reloaded from database"
        dump( ).
      endif.

      loop at load_ref->* assigning field-symbol(<on_save_det>) where kind eq 'D' and exec_type eq 'S'.
        data(ltabix) = sy-tabix.
        data(id) = sy-tabix.
        data(ic) = 0.
        data(im) = 0.
        if ( <on_save_det>-flags bit-and flag_draft_only ) ne flags_none.
          continue.
        endif.
        read table impls with key entity  = <on_save_det>-owner_entity
                                  kind    = 'd'
                                  op_info = <on_save_det>-name
          assigning field-symbol(<impl>).
        if sy-subrc eq 0.
          ic = <impl>-ic.
          im = <impl>-im.
          id = 0.
        endif.
        insert value #( det_tabix = ltabix id = id ic = ic im = im ) into table det_exec.
      endloop.
      insert value #( root_name = root_entity_name load_ref = load_ref det_exec = det_exec ) into table det_on_save_exec_ctx assigning <exec_ctx>.
    else.
      load_ref = <exec_ctx>-load_ref.
    endif.
    data(is_optimized) = xsdbool( is_optimization1_active eq abap_true or cl_abap_behv_detval=>is_activate_optimized( root_entity_name ) eq abap_true ).
    data(start_t) = buffer->add_call_count.
    data(no_change_count) = 0.
    data(dvm_log) = new lcl_dvm_log( reported_log = log late_response = abap_true ).
    do.
      loop at <exec_ctx>-det_exec assigning field-symbol(<det_exec>)
          group by ( key1 = <det_exec>-id key2 = <det_exec>-ic key3 = <det_exec>-im ).
        data(djob) = cl_abap_behv_djob=>create( dvm_log ).
        data(exec_djob) = space.
        data(handler_params) = 0.
        loop at group <det_exec> assigning field-symbol(<det_handler>).
          read table load_ref->* index <det_handler>-det_tabix assigning field-symbol(<det_load>).
          data(instances) = buffer->get_instances( root_name = root_entity_name load = <det_load>-load last_t = <det_handler>-exec_t ).
          <det_handler>-exec_t = buffer->add_call_count.
          if instances is not initial and instances->* is not initial.
            if is_optimized eq abap_true.
              detact_buffer->filter_instances(
                            exporting entity_name        = <det_load>-owner_entity
                                      detval_kind        = 'D'
                                      detval_name        = <det_load>-name
                                      triggers           = <det_load>-triggers
                                      has_draft          = abap_false
                            changing  instances          = instances->* ).
              if instances->* is initial.
                no_change_count += 1.
                continue.
              endif.
            endif.
            exec_djob = 'X'.
            handler_params += 1.
            <det_handler>-exec_count += 1.
            if <det_handler>-exec_count >= max_det_on_save_exec_count.
              endless_on_save_dump( culprit_root_name = root_entity_name
                                    det_exec          = <exec_ctx>-det_exec ).
              return. "for unit tests
            endif.
            me->add_determination( entity_name        = <det_load>-owner_entity
                                   determination_name = <det_load>-name
                                   instances          = value #( ( trigger_entity = <det_load>-owner_entity instances = instances ) )
                                   djob               = djob ).
          else.
            no_change_count += 1.
          endif.
        endloop.
        if exec_djob ne space.
          exec_job( job = djob kind = 'D' ).
          if start_t eq buffer->add_call_count.
            no_change_count += handler_params.
          else.
            clear no_change_count.
            start_t = buffer->add_call_count.
          endif.
        endif.
        if no_change_count >= lines( <exec_ctx>-det_exec ).
          exit.
        endif.
      endloop.
      if no_change_count >= lines( <exec_ctx>-det_exec ).
        exit.
      endif.
    enddo.
    clear det_on_save_active.
  endmethod.

  method endless_on_save_dump.
    data(load_ref) = me->cache->get_bo_load_ref( culprit_root_name ).
    data det_cycle_for_dump type table of string with empty key.
    loop at det_exec assigning field-symbol(<det>) where exec_count > max_det_on_save_exec_count / 4.
      read table load_ref->* index <det>-det_tabix assigning field-symbol(<det_load>).
      append |{ <det_load>-owner_entity }.{ <det_load>-raw_name }| to det_cycle_for_dump.
    endloop.
    data info type string.
    concatenate lines of det_cycle_for_dump into info separated by ` , `.
    dump( kind              = endless_on_save
          culprit_root_name = culprit_root_name
          info              = info ).
  endmethod.

  method if_abap_behv_detval~exec_determinations_on_modify.
    if for_unmanaged is not initial.
      read table cache->bo_properties with table key table_line = root_entity_name transporting no fields.
      if sy-subrc ne 0.
        return.
      endif.
    endif.
    if val_active is not initial.
      dump( kind = modify_in_validation ).
    endif.
    try.
      bo_stack->push( root_entity_name ).
    catch lcx_duplicative_bo.
      dump( kind              = cross_bo_modify_cycle_in_det
            culprit_root_name = root_entity_name ).
      return. "for unit tests
    catch lcx_depth_exceeded.
      dump( kind              = endless_on_modify
            culprit_root_name = root_entity_name ).
      return. "for unit tests
    endtry.
    data(dvm_log) = new lcl_dvm_log( reported_log = log late_response = abap_false ).
    data djob type ref to cl_abap_behv_djob.
    loop at pending_det_on_mod_instances assigning field-symbol(<dp>) using key bo
       where root_name eq root_entity_name.
      if djob is initial.
        djob = cl_abap_behv_djob=>create( dvm_log ).
      endif.
      field-symbols <tab> type any table.
      assign <dp>-instances->* to <tab>.
      sort <tab> by table_line. "#EC CI_SORTLOOP
      delete adjacent duplicates from <tab> comparing all fields.
      me->add_determination( entity_name        = <dp>-entity_name
                             determination_name = <dp>-detval_name
                             instances          = value #( ( trigger_entity = <dp>-entity_name instances = <dp>-instances ) )
                             djob               = djob ).
    endloop.
    if djob is not initial.
      delete pending_det_on_mod_instances using key bo where root_name eq root_entity_name.
      exec_job( job = djob kind = 'D' ).
    endif.
    bo_stack->pop( ).
  endmethod.

  method if_abap_behv_detval~exec_validations.
    assert det_on_save_active is initial
       and bo_stack->stack is initial
       and val_active is initial.
    data vjob type ref to cl_abap_behv_vjob.
    data(is_optimized) = xsdbool( is_optimization1_active eq abap_true or cl_abap_behv_detval=>is_activate_optimized( root_entity_name ) eq abap_true ).
    val_active = abap_true.
    data(load_ref) = me->cache->get_bo_load_ref( root_entity_name ).
    data(dvm_log) = new lcl_dvm_log( reported_log = log failed_log = log late_response = abap_true ).
    loop at load_ref->* assigning field-symbol(<val_load>) where kind eq 'V'.
      assert <val_load>-exec_type eq 'S'.
      if ( <val_load>-flags bit-and flag_draft_only ) ne flags_none.
        continue.
      endif.
      data(instances) = buffer->get_instances( root_name = root_entity_name load = <val_load>-load last_t = 0 ).
      if instances is not initial and instances->* is not initial.
        if is_optimized eq abap_true.
          detact_buffer->filter_instances(
                            exporting entity_name        = <val_load>-owner_entity
                                      detval_kind        = 'V'
                                      detval_name        = <val_load>-name
                                      triggers           = <val_load>-triggers
                                      has_draft          = abap_false
                            changing  instances          = instances->* ).
        endif.
        if instances->* is initial.
          continue.
        endif.

        if vjob is initial.
          vjob = cl_abap_behv_vjob=>create( dvm_log ).
        endif.
        me->add_validation( entity_name      = <val_load>-owner_entity
                            validation_name  = <val_load>-name
                            instances        = value #( ( trigger_entity = <val_load>-owner_entity instances = instances ) )
                            vjob             = vjob ).
      endif.
    endloop.
    if vjob is not initial.
      exec_job( job = vjob kind = 'V' ).
    endif.
    clear val_active.
  endmethod.

  method exec_job.
    cl_abap_behv_ctrl=>get_handlers(
      exporting job = job
                kind = kind
      importing handlers = data(handlers) ).
    loop at handlers assigning field-symbol(<handler>).
      cl_abap_behv_ctrl=>call_handler( handler = <handler>-handler
                                       root    = <handler>-root
                                       params  = ref #( <handler>-params )
                                       job     = job ).
    endloop.
  endmethod.

  method if_abap_behv_detval~cleanup.
    assert val_active is initial and
           bo_stack->stack is initial and "no on modify determination is active
           det_on_save_active is initial.
    clear: pending_det_on_mod_instances,
           det_on_save_exec_ctx.
    buffer->cleanup( ).
    detact_buffer->cleanup(  ).
  endmethod.

  method if_abap_behv_detval~cleanup_finalize.
    assert val_active is initial and
           bo_stack->stack is initial and "no on modify determination is active
           det_on_save_active is initial.
    clear: det_on_save_exec_ctx.
  endmethod.

  method init_control.
    if tab is initial.
      return.
    endif.
    "init %control
    read table tab index 1 assigning field-symbol(<tab_line>).
    assign component '%CONTROL' of structure <tab_line> to field-symbol(<ctrl>).
    data(key_comps) = buffer->get_nr_of_key_comps( entity_name ).
    do.
      if sy-index > key_comps.
        exit.
      endif.
      assign component sy-index of structure <ctrl> to field-symbol(<ctrl_comp>).
      assert sy-subrc eq 0.
      <ctrl_comp> = if_abap_behv=>mk-on. "marks key components only
    enddo.
    loop at tab assigning <tab_line>.
      assign component '%CONTROL' of structure <tab_line> to field-symbol(<tab_line_ctrl>).
      <tab_line_ctrl> = <ctrl>.
    endloop.
  endmethod.

  method get_instances_all.
    field-symbols <instances> type any table.
    field-symbols <parameters> type any table.
    if instances is not initial.
      parameters = cl_abap_behvdescr=>create_data( p_name = load-owner_entity
                                                   p_op = cond #( when load-kind eq 'V'
                                                                    then cl_abap_behvdescr=>op_validate
                                                                    else cl_abap_behvdescr=>op_determine )
                                                   p_sub_name = load-name ).
      assign instances->* to <instances>.
      assign parameters->* to <parameters>.
      move-corresponding <instances> to <parameters>.
    endif.
  endmethod.

  method get_existing_instances.
    data(source_instances) = cl_abap_behvdescr=>create_data( p_name = entity_name
                                                             p_op   = cl_abap_behvdescr=>op_read ).
    assign instances->* to field-symbol(<instances>).
    if <instances> is initial.
      return.
    endif.
    field-symbols <source_instances> type index table.
    assign source_instances->* to <source_instances>.
    if is_draft eq 'X'.
      cl_abap_corresponding=>create_with_value( source = <instances>
                                                destination = <source_instances>
                                                mapping = VALUE #( ( kind = cl_abap_corresponding=>mapping_value
                                                                     dstname = '%IS_DRAFT'
                                                                     value = REF #( if_abap_behv=>mk-on ) ) )
                        )->execute( EXPORTING source = <instances>
                                    CHANGING  destination = <source_instances> ).
      has_draft = abap_true.
    else.
      move-corresponding <instances> to <source_instances>.
      assign component '%IS_DRAFT' of structure <source_instances>[ 1 ] to field-symbol(<is_draft>).
      if sy-subrc eq 0 and <is_draft> is not initial.
        has_draft = abap_true.
      endif.
    endif.
    init_control( exporting entity_name = entity_name changing tab = <source_instances> ).

    data(result_instances) = cl_abap_behvdescr=>create_data( p_name = entity_name
                                                             p_op   = cl_abap_behvdescr=>op_read
                                                             p_kind = if_abap_behv=>typekind-result ).

* use job to do the following without BEHAVIOR_INTERNAL_ACCESS
*    read entities in local mode operations value #( ( op          = if_abap_behv=>op-r-read
*                                        entity_name = entity_name
*                                        instances   = source_instances
*                                        full        = 'X'
*                                        results     = result_instances )
*                                    )
*      failed data(it_failed).
    data(rjob) = cl_abap_behv_rjob=>create( exporting for_eml = ' ' in_local_mode = 'X' ).
    data ret_tab type abp_behv_retrievals_tab.
    ret_tab = value #( ( op          = if_abap_behv=>op-r-read
                                       entity_name = entity_name
                                       instances   = source_instances
                                       full        = 'X'
                                       results     = result_instances )
                                   ).
    rjob->add_retrievals_tab_read( exporting retrievals = ret_tab ).
    data it_failed type abp_behv_response_tab.
    cl_abap_behv_ctrl=>execute_read( exporting job = rjob dynamic = 'X' changing failed = it_failed ).

    existing_instances = result_instances. "type acceptable, no move-corresponding necessary here
    if it_failed is not initial and log is not initial.
      read table it_failed with key entity_name = entity_name assigning field-symbol(<failed>).
      if sy-subrc eq 0 and <failed>-entries is not initial.
        assign <failed>-entries->* to field-symbol(<failed_entries>).
        if <failed_entries> is not initial.
          data(action) = '%ACTION-' && to_upper( det_act_name ).
          loop at <failed_entries> assigning field-symbol(<failed_entry>).
            assign component action of structure <failed_entry> to field-symbol(<flag>).
            if sy-subrc eq 0.
              <flag> = if_abap_behv=>mk-on.
            endif.
          endloop.
          log->add( kind        = if_abap_behv_log=>failed
                    root_name   = root_name
                    entity_name = entity_name
                    instances   = <failed_entries> ).
        endif.
      endif.
    endif.

  endmethod.

  method if_abap_behv_detval~exec_determine_action.
    if   det_on_save_active is not initial
      or bo_stack->stack is not initial
      or val_active is not initial.
      dump( det_act_not_permitted ).
    endif.
    if instances is initial.
      return.
    endif.
    data root_entity_name type abp_root_entity_name.
    data cache type tt_det_action_instances.
    data rc type i.
    "1) get load of det_action
    data(detvals) = me->cache->get_load_det_action( exporting entity       = entity_name
                                                              det_act_name = det_act_name ).
    data(load_ref) = me->cache->get_bo_load_ref( exporting entity = entity_name
                                                 importing root_entity = root_entity_name ).

    data has_draft type sap_bool.
    data(instances0) = get_existing_instances( exporting root_name    = root_entity_name
                                                         entity_name  = entity_name
                                                         instances    = instances
                                                         log          = log
                                                         is_draft     = is_draft
                                                         det_act_name = det_act_name
                                               importing has_draft    = has_draft ).

    det_on_save_active = abap_true.
    data det_exec type tt_det_exec.
    data draft_service type ref to if_behv_draft_services.
    if has_draft is not initial.
      data(head) = me->cache->get_load_head( root_entity_name ).
      if head-draftkind ne cl_abap_behv_load=>c_draftkind_bopf.
        draft_service = cl_csp_behv_draft_srv_factory=>get_draft_services( ).
      else.
        draft_service = /bobf/cl_behv_handler_factory=>get_draft_services( root_entity_name ).
      endif.
      data(need_flush) = abap_true.
    endif.

    data(impls) = cl_abap_behv_detval=>get_det_on_save_impls( exporting root_name = root_entity_name
                                                              importing rc        = rc ).
    if not ( rc is initial or rc eq 4 ). "rc is "ok" or "reloaded from database"
      dump( ).
    endif.

    loop at detvals assigning field-symbol(<det>) where kind eq 'D'.
      read table load_ref->* with table key owner_entity = <det>-owner_entity name = <det>-name transporting no fields.
      assert sy-subrc eq 0.
      data(ltabix) = sy-tabix.
      data(id) = sy-tabix.
      data(ic) = 0.
      data(im) = 0.
      read table impls with key entity  = <det>-owner_entity
                                kind    = 'd'
                                op_info = <det>-name
        assigning field-symbol(<impl>).
      if sy-subrc eq 0.
        ic = <impl>-ic.
        im = <impl>-im.
        id = 0.
      endif.
      insert value #( det_tabix = ltabix id = id ic = ic im = im always_flag = <det>-flags ) into table det_exec.
    endloop.

    data(is_optimized) = xsdbool( is_optimization1_active eq abap_true or cl_abap_behv_detval=>is_activate_optimized( root_entity_name ) eq abap_true ).
    data(start_t) = buffer->add_call_count.
    data(initial_t) = start_t.
    data(no_change_count) = 0.
    data failed_log type ref to if_abap_behv_log.
    if is_draft eq abap_true.
      failed_log = cl_dsp_utl_behv_log_factory=>get( )->get_behv_prepare_log( ).
    endif.
    if is_optimized eq abap_true.
      failed_log = new lcl_detact_fail_log( failed_log    = failed_log
                                            detact_buffer = detact_buffer ).
    endif.
    data(dvm_log) = new lcl_dvm_log( reported_log = log failed_log = failed_log late_response = abap_false ).
    do.
      loop at det_exec assigning field-symbol(<det_exec>) group by ( key1 = <det_exec>-id key2 = <det_exec>-ic key3 = <det_exec>-im ).
        data(djob) = cl_abap_behv_djob=>create( dvm_log ).
        data(exec_djob) = space.
        data(handler_params) = 0.
        if has_draft is not initial and need_flush is not initial
          and draft_service is not initial.
          draft_service->flush_pending_operations( root_entity_name ).
          need_flush = abap_false.
        endif.
        loop at group <det_exec> assigning field-symbol(<det_handler>).
          read table load_ref->* index <det_handler>-det_tabix assigning field-symbol(<det_load>).
          if ( <det_handler>-exec_t > 0 or
               ( has_draft is initial and <det_handler>-always_flag is initial ) ) and
             <det_handler>-exec_t >= buffer->get_last_change_t( <det_load>-owner_entity ).
            no_change_count += 1.
            continue.
          endif.
          data(det_instances) = navigate_instances_detval( exporting from        = entity_name
                                                                     to          = <det_load>-owner_entity
                                                                     instances   = instances0
                                                                     op          = cl_abap_behvdescr=>op_determine
                                                                     detval_name = <det_load>-name
                                                           changing  cache       = cache ).
          if <det_handler>-always_flag is initial or <det_handler>-exec_t > 0.
            data(trig_instances) = buffer->get_instances_filtered( load = <det_load>-load last_t = <det_handler>-exec_t filter = det_instances has_draft = has_draft ).
            if trig_instances is not initial and is_optimized eq abap_true.
              detact_buffer->filter_instances( exporting entity_name = <det_load>-owner_entity
                                                         detval_kind = 'D'
                                                         detval_name = <det_load>-name
                                                         triggers    = <det_load>-triggers
                                                         has_draft   = has_draft
                                               changing  instances   = trig_instances->* ).
              if trig_instances->* is initial.
                <det_handler>-exec_t = buffer->add_call_count.
                no_change_count += 1.
                continue.
              endif.
            endif.
          else.
            "always flag
            if initial_t eq buffer->add_call_count or entity_name ne <det_load>-owner_entity. "existence check not necessary
              trig_instances = get_instances_all( load = <det_load>-load instances = det_instances ).
            else.
              trig_instances = buffer->get_instances_for_always( load = <det_load>-load filter = det_instances ).
            endif.
          endif.
          <det_handler>-exec_t = buffer->add_call_count.
          if trig_instances is not initial and trig_instances->* is not initial.
            handler_params += 1.
            exec_djob = 'X'.
            <det_handler>-exec_count += 1.
            if <det_handler>-exec_count >= max_det_on_save_exec_count.
              endless_on_save_dump( culprit_root_name = root_entity_name
                                    det_exec          = det_exec ).
              return. "for unit tests
            endif.
            me->add_determination( entity_name        = <det_load>-owner_entity
                                   determination_name = <det_load>-name
                                   instances          = value #( ( trigger_entity = <det_load>-owner_entity instances = trig_instances ) )
                                   djob               = djob ).
            if is_optimized eq abap_true.
              detact_buffer->store_detval_exec( entity_name        = <det_load>-owner_entity
                                                detval_kind        = 'D'
                                                detval_name        = <det_load>-name
                                                has_draft          = has_draft
                                                instances          = trig_instances ).
            endif.
          else.
            no_change_count += 1.
          endif.
        endloop.
        if exec_djob is not initial.
          exec_job( job = djob kind = 'D' ).
          need_flush = abap_true.
          if start_t eq buffer->add_call_count.
            no_change_count += handler_params.
          else.
            clear no_change_count.
            start_t = buffer->add_call_count.
          endif.
        endif.
        if no_change_count >= lines( det_exec ).
          exit.
        endif.
      endloop.
      if no_change_count >= lines( det_exec ).
        exit.
      endif.
    enddo.
    clear det_on_save_active.

    val_active = 'X'.
    if has_draft is not initial.
      if need_flush is not initial and draft_service is not initial.
        draft_service->flush_pending_operations( root_entity_name ).
      endif.
      val_active_draft = 'X'.
    endif.
    data(vjob) = cl_abap_behv_vjob=>create( dvm_log ).
    loop at detvals assigning field-symbol(<val>) where kind eq 'V'.
      if has_draft is initial and
         <val>-flags is initial and "no always flag
         buffer->get_last_change_t( <val>-owner_entity ) eq 0.
        continue.
      endif.
      data(val_instances) = navigate_instances_detval( exporting from        = entity_name
                                                                 to          = <val>-owner_entity
                                                                 instances   = instances0
                                                                 op          = cl_abap_behvdescr=>op_validate
                                                                 detval_name = <val>-name
                                                       changing  cache       = cache ).
      read table load_ref->* with table key owner_entity = <val>-owner_entity name = <val>-name assigning field-symbol(<val_load>).
      assert sy-subrc eq 0.
      if <val>-flags is initial.
        trig_instances = buffer->get_instances_filtered( load = <val_load>-load last_t = 0 filter = val_instances has_draft = has_draft ).
        if trig_instances is not initial and is_optimized eq abap_true.
          detact_buffer->filter_instances( exporting entity_name = <val>-owner_entity
                                                     detval_kind = 'V'
                                                     detval_name = <val>-name
                                                     triggers    = <val_load>-triggers
                                                     has_draft   = has_draft
                                           changing  instances   = trig_instances->* ).
          if trig_instances->* is initial.
            continue.
          endif.
        endif.
      else.
        "always flag
        if initial_t = buffer->add_call_count or entity_name ne <det_load>-owner_entity. "existence check not necessary
          trig_instances = get_instances_all( load = <val_load>-load instances = val_instances ).
        else.
          trig_instances = buffer->get_instances_for_always( load = <val_load>-load filter = val_instances ).
        endif.
      endif.
      if trig_instances is not initial and trig_instances->* is not initial.
        me->add_validation( entity_name        = <val>-owner_entity
                            validation_name    = <val>-name
                            instances          = value #( ( trigger_entity = <val>-owner_entity
                                                            instances      = trig_instances ) )
                            vjob               = vjob ).
        if is_optimized eq abap_true.
          detact_buffer->store_detval_exec( entity_name        = <val_load>-owner_entity
                                            detval_kind        = 'V'
                                            detval_name        = <val_load>-name
                                            has_draft          = has_draft
                                            instances          = trig_instances ).
        endif.
      endif.
    endloop.
    exec_job( job = vjob kind = 'V' ).
    clear: val_active, val_active_draft.
  endmethod.

  method navigate_instances_detval.
    data(to_instances) = navigate_instances( exporting from = from to = to instances = instances changing cache = cache ).
    res_instances = cl_abap_behvdescr=>create_data( p_name = to p_op = op p_sub_name = detval_name ).
    field-symbols: <to_tab> type any table, <res_tab> type any table.
    assign to_instances->* to <to_tab>.
    assign res_instances->* to <res_tab>.
    move-corresponding <to_tab> to <res_tab>.
  endmethod.

  method navigate_instances.
    if from eq to.
      to_instances = instances.
      return.
    endif.
    read table cache with table key entity_name = to assigning field-symbol(<cache_line>).
    if sy-subrc eq 0 and <cache_line>-t eq buffer->add_call_count. "no change -> use cache
      to_instances = <cache_line>-instances.
      return.
    endif.
    try.
      bo_trees->get_parent_info( exporting entity_name        = to
                                 importing parent_name        = data(parent)
                                           to_child_asso_name = data(to_child) ).
    catch lcx_cds_metadata_missing.
      dump( cds_metadata_missing ).
    endtry.
    data(parent_instances) = navigate_instances( exporting from      = from
                                                           to        = parent
                                                           instances = instances
                                                 changing  cache     = cache ).
    "prepare source for read entities
    data(source_instances) = cl_abap_behvdescr=>create_data( p_name = parent
                                                             p_op   = cl_abap_behvdescr=>op_read_ba
                                                             p_sub_name = conv #( to_child ) ).
    field-symbols: <source> type index table, <source0> type any table.
    assign parent_instances->* to <source0>.
    assign source_instances->* to <source>.
    move-corresponding <source0> to <source>.
    init_control( exporting entity_name = to changing tab = <source> ).

    data(result_instances) = cl_abap_behvdescr=>create_data( p_name = parent
                                                             p_op   = cl_abap_behvdescr=>op_read_ba
                                                             p_kind = if_abap_behv=>typekind-result
                                                             p_sub_name = conv #( to_child ) ).

* use job to do the following without BEHAVIOR_INTERNAL_ACCESS:
*    read entities in local mode operations value #( ( op          = if_abap_behv=>op-r-read_ba
*                                        entity_name = parent
*                                        sub_name    = to_child
*                                        instances   = source_instances
*                                        full        = 'X'
*                                        results     = result_instances )
*                                    ).
    data(rjob) = cl_abap_behv_rjob=>create( exporting for_eml = ' ' in_local_mode = 'X' ).
    data ret_tab type abp_behv_retrievals_tab.
    ret_tab = value #( ( op          = if_abap_behv=>op-r-read_ba
                                       entity_name = parent
                                       sub_name    = to_child
                                       instances   = source_instances
                                       full        = 'X'
                                       results     = result_instances )
                                   ).
    rjob->add_retrievals_tab_read( exporting retrievals = ret_tab ).
    cl_abap_behv_ctrl=>execute_read( exporting job = rjob dynamic = 'X' ).

    "transform results into to_instances:
    field-symbols: <result0> type any table, <result> type any table.
    assign result_instances->* to <result0>.
    to_instances = cl_abap_behvdescr=>create_data( p_name = to
                                                   p_op   = cl_abap_behvdescr=>op_virtual_tkey ).
    assign to_instances->* to <result>.
    move-corresponding <result0> to <result>.

    "update cache
    if <cache_line> is assigned.
      <cache_line>-instances = to_instances.
      <cache_line>-t         = buffer->add_call_count.
    else.
      insert value t_det_action_instances( entity_name = to instances = to_instances t = buffer->add_call_count ) into table cache.
    endif.
  endmethod.

  method add_determination.
    djob->add_determinations( entity_name        = entity_name
                              determination_name = determination_name
                              instances          = instances ).
  endmethod.

  method add_validation.
    vjob->add_validations( entity_name        = entity_name
                           validation_name    = validation_name
                           instances          = instances ).
  endmethod.

  method if_abap_behv_detval~check_finalize_is_complete.
*    if cl_feature_toggle=>is_active( if_rap_feature_toggle_ids=>c_incompatible_changes-in_release_2202 ) is not initial.
*      return.
*    endif.
    loop at det_on_save_exec_ctx assigning field-symbol(<ctx>).
      data(final_exec_t) = buffer->get_final_exec_t( <ctx>-root_name ).
      loop at <ctx>-det_exec assigning field-symbol(<incomplete_det_exec>)
        where exec_t < final_exec_t.
        dump( culprit_root_name = <ctx>-root_name
              kind = det_on_save_not_complete ).
      endloop.
    endloop.
  endmethod.

  method if_abap_behv_detval~read_control_flags.
    buffer->read_control_flags( exporting entity_name   = entity_name
                                          keys          = keys
                                receiving control_flags = control_flags ).
  endmethod.

endclass.

class lcl_load_cache implementation.
  method get_flags.
    read table bo_load_cache with table key entity_name = entity assigning field-symbol(<dvm_load>).
    if sy-subrc eq 0.
      data(load) = <dvm_load>-load.
    else.
      load = get_load( exporting entity = entity ).
    endif.
    read table load with key owner_entity = entity assigning field-symbol(<load_detval>).
    if sy-subrc eq 0.
      flags = <load_detval>-flags.
    endif.
  endmethod.

  method get_bo_load_ref.
    read table bo_load_cache with table key entity_name = entity assigning field-symbol(<dvm_load>).
    if sy-subrc eq 0.
      load_ref = ref #( <dvm_load>-load ).
      root_entity = <dvm_load>-root_name.
      return.
    else.
      get_load( exporting entity = entity importing root_entity = root_entity ).
      read table bo_load_cache with table key entity_name = entity assigning <dvm_load>.
      assert sy-subrc eq 0.
      load_ref = ref #( <dvm_load>-load ).
    endif.
  endmethod.

  method get_load_head.
    read table bo_load_cache with table key entity_name = entity assigning field-symbol(<dvm_load>).
    if sy-subrc ne 0.
      get_load( entity = entity ).
      read table bo_load_cache with table key entity_name = entity assigning <dvm_load>.
    endif.
    head = <dvm_load>-head.
  endmethod.

  method get_load_det_action.
    read table bo_load_cache with table key entity_name = entity assigning field-symbol(<dvm_load>).
    if sy-subrc eq 0.
      data(det_actions) = <dvm_load>-det_actions.
    else.
      get_load( exporting entity = entity importing det_actions = det_actions ).
    endif.
    read table det_actions with table key owner_entity = entity name = det_act_name assigning field-symbol(<det_act>).
    if sy-subrc eq 0.
      detvals = <det_act>-detvals.
    endif.
  endmethod.
  method get_load.
    data bo_load_dvm type cl_abap_behv_load=>tt_detval_dvm.
    data bo_det_actions type cl_abap_behv_load=>tt_determine_action.
    data bo_head type cl_abap_behv_load=>t_head.
    root_entity = cl_abap_behvdescr=>get_root( entity ).
    read table bo_load_cache with key bo components root_name = root_entity assigning field-symbol(<dvm_load>).
    if sy-subrc eq 0.
      insert value #( entity_name = entity root_name = root_entity
                      load = <dvm_load>-load det_actions = <dvm_load>-det_actions head = <dvm_load>-head )
                    into table bo_load_cache.
      load = <dvm_load>-load.
      det_actions = <dvm_load>-det_actions.
      return.
    endif.
    cl_abap_behv_load=>get_load(
       exporting
         entity = entity
         all    = 'X'
       importing
         head               = bo_head
         detvals_dvm        = bo_load_dvm
         determine_actions  = bo_det_actions
       changing
         root_entity = root_entity ).
    if bo_head-impltype eq cl_abap_behv_load=>c_impltype_UNMANAGED and
       bo_head-ext_with_dets_on_modify is not initial.
       insert root_entity into table bo_properties.
    endif.
    load = corresponding #( bo_load_dvm ).
    loop at load assigning field-symbol(<load_entity>) group by <load_entity>-owner_entity.
      data flags type cl_abap_behv_load=>t_detval_dvm_flags.
      clear flags.

      loop at group <load_entity> assigning field-symbol(<load_detval>).
        assert <load_detval>-flags bit-and ( lcl_detval=>flag_draft_only bit-or lcl_detval=>flag_not_in_local_mode ) eq  <load_detval>-flags.
        if <load_detval>-exec_type eq 'M'.
          flags = flags bit-or lcl_detval=>flag_has_on_mod.
        endif.
        loop at <load_detval>-triggers assigning field-symbol(<trigger>).
          if <trigger>-op eq cl_abap_behv_load=>c_trigger_field.
            if <load_detval>-exec_type eq 'M'.
              flags = flags bit-or lcl_detval=>flag_has_on_mod_field.
            endif.
            <load_detval>-flags = <load_detval>-flags bit-or lcl_detval=>flag_detval_has_field_trigger.
          else.
            assert <trigger>-op ca 'CUD'.
            <load_detval>-flags = <load_detval>-flags bit-or lcl_detval=>flag_detval_has_cud_trigger.
          endif.
        endloop.
      endloop.
      loop at group <load_entity> assigning <load_detval>.
        <load_detval>-flags = <load_detval>-flags bit-or flags.
        <load_detval>-nilm_chk_extfrnd_grp = -99.
      endloop.
    endloop.
    insert value #( root_name   = root_entity
                    entity_name = root_entity
                    head        = bo_head
                    load        = load
                    det_actions = bo_det_actions ) into table bo_load_cache.
    det_actions = bo_det_actions.
  endmethod.
endclass.

class lcl_detact_fail_log implementation.
  method if_abap_behv_log~add.
    if failed_log is not initial.
      failed_log->add( exporting kind = kind
                                 root_name = root_name
                                 entity_name = entity_name
                                 instances = instances
                                 entity_index = entity_index
                                 flavor = flavor ).
    endif.
    detact_buffer->invalidate_val_exec( entity_name = entity_name
                                        instances   = instances ).
  endmethod.

  method constructor.
    me->failed_log = failed_log.
    me->detact_buffer = detact_buffer.
  endmethod.

endclass.

class lcl_detact_buffer implementation.
  method constructor.
    me->buffer = buffer.
  endmethod.

  method store_detval_exec.
    field-symbols: <detact_buffer_table> type ty_detact_buffer.
    if has_draft is initial.
      assign detact_buffer to <detact_buffer_table>.
    else.
      assign detact_buffer_draft to <detact_buffer_table>.
    endif.
    read table <detact_buffer_table> with table key entity_name = entity_name detval_kind = detval_kind detval_name = detval_name
        assigning field-symbol(<b>).

    if sy-subrc ne 0.
      data(root_name) = cl_abap_behvdescr=>get_root( entity_name ).
      data(detact_buffer_type_name) = |\\BDEF={ root_name }\\ENTITY={ entity_name }\\TYPE=DVMBUFFER2|.
      data(type_descr) = cast cl_abap_tabledescr( cl_abap_typedescr=>describe_by_name( detact_buffer_type_name ) ).
      insert value #( entity_name = entity_name detval_kind = detval_kind detval_name = detval_name ) into table <detact_buffer_table> assigning <b>.
      create data <b>-instances_t type handle type_descr.
      data(wa_type) = type_descr->get_table_line_type( ).
      create data <b>-wa_instance_t type handle wa_type.
    endif.
    insert value #( new_instances = instances exec_t = buffer->add_call_count ) into table <b>-new_instances.
  endmethod.

  method invalidate_val_exec.
      field-symbols <dat_buffer> type ty_detact_buffer.
      assign detact_buffer to <dat_buffer>.
      loop at instances assigning field-symbol(<instance>).
        assign component '%IS_DRAFT' of structure <instance> to field-symbol(<is_draft>).
        if sy-subrc = 0 and <is_draft> is not initial.
          assign detact_buffer_draft to <dat_buffer>.
        endif.
        assign component '%PID' of structure <instance> to field-symbol(<tst>).
        if sy-subrc eq 0.
          data(key_name) = `PID`.
        else.
          key_name = `ENTITY`.
        endif.
        exit.
      endloop.

      loop at <dat_buffer> assigning field-symbol(<b>) where entity_name = entity_name and detval_kind eq 'V'. " and exec_t = buffer->add_call_count
        assign <b>-instances_t->* to field-symbol(<b_instances_t>).
        assign <b>-wa_instance_t->* to field-symbol(<wa_instance_t>).
        if <b>-new_instances is not initial.
          loop at <b>-new_instances assigning field-symbol(<l>).
            join_instances( exporting instances = <l>-new_instances->*
                                      exec_t = <l>-exec_t
                                      key_name = key_name
                            changing  instances_t = <b>-instances_t->* ).
          endloop.
          clear <b>-new_instances.
        endif.

        loop at instances assigning <instance>.
          move-corresponding exact <instance> to <wa_instance_t>.
          read table <b_instances_t> from <wa_instance_t> using key (key_name) assigning field-symbol(<instance_t>).
          if sy-subrc eq 0.
          assign component 'T' of structure <instance_t> to field-symbol(<exec_t>).
            if <exec_t> = buffer->add_call_count.
              delete table <b_instances_t> from <instance_t> using key (key_name).
            endif.
          endif.
        endloop.
      endloop.
  endmethod.

  method join_instances.
    field-symbols: <instance_t> type data.
    field-symbols: <fs_t> type i.

    if instances_t is initial.
      " If the table instances_t is empty, all new instances can be moved directly to instances_t
      move-corresponding instances to instances_t.
      loop at instances_t assigning <instance_t>.
        assign component 'T' of structure <instance_t> to <fs_t>.
        <fs_t> = exec_t.
      endloop.
    else.
      data new_instance_t type ref to data.
      create data new_instance_t like line of instances_t.
      loop at instances assigning field-symbol(<instance>).
        move-corresponding exact <instance> to new_instance_t->*.
        read table instances_t from new_instance_t->* using key (key_name) assigning <instance_t>.
        if sy-subrc = 0.
          " Update T if there is a newer execution
          assign component 'T' of structure <instance_t> to <fs_t>.
          if <fs_t> < exec_t.
            <fs_t> = exec_t.
          endif.
        else.
          " Instance does not exist, add it to instances_t
          assign component 'T' of structure new_instance_t->* to <fs_t>.
          <fs_t> = exec_t.
          insert new_instance_t->* into table instances_t.
        endif.
      endloop.
    endif.
  endmethod.

  method filter_instances.
    if has_draft eq abap_false.
      read table detact_buffer with table key entity_name = entity_name detval_kind = detval_kind detval_name = detval_name transporting no fields.
      if sy-subrc ne 0.
        return.
      endif.
      assign detact_buffer to field-symbol(<detact_buffer>).
    else.
      read table detact_buffer_draft with table key entity_name = entity_name detval_kind = detval_kind detval_name = detval_name transporting no fields.
      if sy-subrc ne 0.
        return.
      endif.
      assign detact_buffer_draft to <detact_buffer>.
    endif.
    read table me->buffer->buffer with table key entity_name = entity_name assigning field-symbol(<ebuffer>).
    assert sy-subrc eq 0.
    assign <ebuffer>-header_line->* to field-symbol(<buffer_read>).
    assign component 'CHANGE-%TKY' of structure <buffer_read> to field-symbol(<buffer_read_tky>).
    field-symbols <buffer_state> type any table.
    assign <ebuffer>-state->* to <buffer_state>.

    assign component '%PID' of structure instances[ 1 ] to field-symbol(<dummy>).
    if sy-subrc eq 0.
      data(key_name) = `PID`.
    else.
      key_name = `ENTITY`.
    endif.


    read table <detact_buffer> with table key entity_name = entity_name detval_kind = detval_kind detval_name = detval_name assigning field-symbol(<b>).
    assign <b>-instances_t->* to field-symbol(<instances_t>).
    assign <b>-wa_instance_t->* to field-symbol(<wa_instnace_t>).
    if <b>-new_instances is not initial.
      loop at <b>-new_instances assigning field-symbol(<l>).
        join_instances( exporting instances = <l>-new_instances->*
                                  exec_t = <l>-exec_t
                                  key_name = key_name
                        changing  instances_t = <b>-instances_t->* ).
      endloop.
      clear <b>-new_instances.
    endif.
    loop at instances assigning field-symbol(<instance>).
      data(ltabix) = sy-tabix.
      "move the values of the instance to be filtered to an instance type with t
      move-corresponding <instance> to <wa_instnace_t>.
      read table <instances_t> from <wa_instnace_t> using key (key_name) assigning field-symbol(<instance_t>).
      if sy-subrc eq 0.
        move-corresponding <instance> to <buffer_read_tky>. "not <buffer_read_tky> = <instance>. "see ver52570
        read table <buffer_state> from <buffer_read> assigning field-symbol(<buffer_item>).
        assert sy-subrc eq 0.
        "determine last change of instance
        assign component 3 of structure <buffer_item> to field-symbol(<buffer_exec_t>).
        final(t) = conv i( <instance_t>-('T') ).
        if t >= <buffer_exec_t> or
          "check if changes of instance after t are relevant for the current det/val
          buffer->triggers( triggers = triggers buffer_item = <buffer_item> last_t = t ) is initial.
          delete instances index ltabix.
        endif.
      endif.
    endloop.
  endmethod.

  method activate.
    loop at changes assigning field-symbol(<change>) where operation ne cl_abap_behv_detval=>op-discard and instances is not initial.
      activate_instances( entity_name = <change>-entity_name instances = <change>-instances->* ).
    endloop.
  endmethod.

  method cleanup.
    clear detact_buffer.
    clear detact_buffer_draft.
  endmethod.

  method activate_instances.
    data(root_name) = cl_abap_behvdescr=>get_root( entity_name ).
    data(prepare) = buffer->load_cache->get_load_det_action( entity = root_name det_act_name = 'PREPARE' ).
    loop at prepare assigning field-symbol(<detval>) where owner_entity = entity_name.
      data(inst) = cl_abap_behvdescr=>create_data( p_name = entity_name
                                                   p_op = cond #( when <detval>-kind eq 'V'
                                                                        then cl_abap_behvdescr=>op_validate
                                                                        else cl_abap_behvdescr=>op_determine )
                                                   p_sub_name = <detval>-name ).
      move-corresponding instances to inst->*.
      store_detval_exec( entity_name = entity_name
                         detval_kind = <detval>-kind
                         detval_name = <detval>-name
                         has_draft   = abap_false
                         instances   = inst ).
    endloop.
  endmethod.

endclass.

class lcl_detval_with_trace implementation.
  method constructor.
    super->constructor( ).
    sxt_tracer = cl_sxt_tracer_factory=>get_instance( )->get_tracer( ).
    xtrace_get_trace_level.
  endmethod.

  method if_abap_behv_detval~add_change_notification_tab.
    xtrace_add_notif c_xtrace_extended changes for_eml.
    super->add_change_notification_tab( changes = changes for_eml = for_eml ).
  endmethod.

  method if_abap_behv_detval~exec_determinations_on_save.
    xtrace_beg_exec2 c_xtrace_essential root_entity_name text-012.
    super->exec_determinations_on_save( root_entity_name = root_entity_name log = log ).
    xtrace_call1 c_xtrace_essential trace_end_exec_detval hierarchy_number.
  endmethod.

  method if_abap_behv_detval~exec_determinations_on_modify.
    xtrace_beg_exec c_xtrace_essential me->pending_det_on_mod_instances root_entity_name text-013.
    super->exec_determinations_on_modify( root_entity_name = root_entity_name log = log for_unmanaged = for_unmanaged ).
    xtrace_call1 c_xtrace_essential trace_end_exec_detval hierarchy_number.
  endmethod.

  method if_abap_behv_detval~exec_validations.
    xtrace_beg_exec2 c_xtrace_essential root_entity_name text-014.
    super->exec_validations( root_entity_name = root_entity_name log = log ).
    xtrace_call1 c_xtrace_essential trace_end_exec_detval hierarchy_number.
  endmethod.

  method if_abap_behv_detval~cleanup.
    data(msg) = conv string( text-002 ).
    xtrace_msg c_xtrace_extended msg text-020.
    super->cleanup( ).
    xtrace_get_trace_level.
  endmethod.

  method if_abap_behv_detval~exec_determine_action.
    if sxt_trace_level >= c_xtrace_essential.
      data(hierarchy_number) = trace_beg_exec_da( params = instances entity_name = entity_name det_act_name = det_act_name ).
    endif.
    super->exec_determine_action( entity_name  = entity_name
                                  det_act_name = det_act_name
                                  instances    = instances
                                  is_draft     = is_draft
                                  log          = log ).
    xtrace_call1 c_xtrace_essential trace_end_exec_da hierarchy_number.
    xtrace_get_trace_level.
  endmethod.

  method add_determination.
    if sxt_trace_level >= c_xtrace_verbose.
      sxt_tracer->trace(
          component = c_sxt_comp_dvm trace_level = c_xtrace_verbose
          message   = text-005 && `, ` && text-008 && `: ` && entity_name && `, ` && text-009 && `: ` && determination_name
          object    = conv #( text-007 )
          procedure = conv #( text-019 )
          content   = instances ).
    endif.
    super->add_determination( entity_name        = entity_name
                              determination_name = determination_name
                              instances          = instances
                              djob               = djob ).
  endmethod.

  method add_validation.
    if sxt_trace_level >= c_xtrace_verbose.
      sxt_tracer->trace(
          component = c_sxt_comp_dvm trace_level = c_xtrace_verbose
          message   = text-005 && `, ` && text-008 && `: ` && entity_name && `, ` && text-010 && `: ` && validation_name
          object    = conv #( text-007 )
          procedure = conv #( text-018 )
          content   = instances ).
    endif.
    super->add_validation( entity_name     = entity_name
                           validation_name = validation_name
                           instances       = instances
                           vjob            = vjob ).
  endmethod.


  method dump_xtrace.
    data msg_str type string.
    get_dump_message(
          EXPORTING kind          = kind
          IMPORTING msg_str       = msg_str ).
    xtrace_msg c_xtrace_essential msg_str text-017.
  endmethod.

  method dump.
    dump_xtrace( exporting kind = kind ). "method call to use same trace in tests
    super->dump( kind              = kind
                 culprit_root_name = culprit_root_name
                 info              = info ).
  endmethod.

*** Tracing of details ***
  method trace_beg_exec_detval.
    if params is supplied and params is initial.
      if sxt_trace_level >= c_xtrace_extended.
        sxt_tracer->trace(
          component = c_sxt_comp_dvm trace_level = c_xtrace_extended
          message   = conv #( text-004 )
          object    = conv #( text-007 )
          processed_objects = conv #( |BDEF:{ root_name }| )
          procedure = proc_name ).
      endif.
    else.
      hierarchy_number = sxt_tracer->begin_hierarchy(
          component = c_sxt_comp_dvm trace_level = c_xtrace_essential
          message   = conv #( text-002 )
          object    = conv #( text-007 )
          processed_objects = conv #( |BDEF:{ root_name }| )
          procedure = proc_name ).
    endif.
  endmethod.

  method trace_end_exec_detval.
    if hierarchy_number is not initial.
      sxt_tracer->end_hierarchy( hierarchy_number = hierarchy_number message = conv #( text-003 ) ).
    endif.
  endmethod.

  method trace_beg_exec_da.
    if params is not initial.
      assign params->* to field-symbol(<params>).
      hierarchy_number = sxt_tracer->begin_hierarchy(
          component = c_sxt_comp_dvm trace_level = c_xtrace_essential
          message   = text-008 && `: ` && entity_name && `, ` && text-011 && `: ` && det_act_name
          object    = conv #( text-007 )
          procedure = conv #( text-015 )
          content   = <params> ).
    else.
      hierarchy_number = sxt_tracer->begin_hierarchy(
          component = c_sxt_comp_dvm trace_level = c_xtrace_essential
          message   = text-008 && `: ` && entity_name && `, ` && text-011 && `: ` && det_act_name
          object    = conv #( text-007 )
          procedure = conv #( text-015 ) ).
    endif.
  endmethod.

  method trace_end_exec_da.
    if hierarchy_number is not initial.
      sxt_tracer->end_hierarchy( hierarchy_number = hierarchy_number message = conv #( text-003 ) ).
    endif.
  endmethod.

  method trace_beg_add_change_notif_tab.
    if sxt_trace_level >= c_xtrace_expert.
      types: begin of ty_content,
        changes type cl_abap_behv_detval=>tt_cud_instances,
        for_eml type sap_bool,
      end of ty_content.
      sxt_tracer->trace( component = c_sxt_comp_dvm trace_level = c_xtrace_expert
                         message   = conv #( text-002 )
                         object    = conv #( text-007 )
                         procedure = text-016
                         content   = value ty_content( changes = changes for_eml = for_eml ) ).
    endif.
  endmethod.
endclass.