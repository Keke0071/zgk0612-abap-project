class lcx_duplicative_bo definition final inheriting from cx_static_check.
endclass.

class lcx_depth_exceeded definition final inheriting from cx_static_check.
endclass.

class lcl_bo_stack definition final.
  public section.
    types : begin of ty_bo_stack_line,
      root_name type abp_root_entity_name,
      bo_stack_depth type i,
    end of ty_bo_stack_line.
    types : tt_bo_stack type standard table of ty_bo_stack_line with empty key
            with unique sorted key bo components root_name.
    data stack type tt_bo_stack read-only.
    methods push
      importing root_name type abp_root_entity_name
        raising lcx_duplicative_bo lcx_depth_exceeded.
    methods pop.
    methods cleanup.
  private section.
    constants max_det_on_mod_bo_stack_depth type i value 20.
endclass.

class lcl_bo_stack implementation.
  method push.
    if stack is not initial.
      data(l) = lines( stack ).
      read table stack index l assigning field-symbol(<top_of_stack>).
      if <top_of_stack>-root_name eq root_name.
        <top_of_stack>-bo_stack_depth += 1.
        if <top_of_stack>-bo_stack_depth >= max_det_on_mod_bo_stack_depth.
          raise exception type lcx_depth_exceeded.
        endif.
        return.
      endif.
    endif.
    try.
      insert value #( root_name = root_name bo_stack_depth = 1 ) into table stack.
    catch cx_sy_itab_duplicate_key.
      raise exception type lcx_duplicative_bo.
    endtry.
  endmethod.
  method pop.
    assert stack is not initial.
    data(l) = lines( stack ).
    read table stack index l assigning field-symbol(<top_of_stack>).
    if <top_of_stack>-bo_stack_depth > 1.
      <top_of_stack>-bo_stack_depth -= 1.
    else.
      delete stack index l.
    endif.
  endmethod.
  method cleanup.
    clear stack.
  endmethod.
endclass.

class lcx_cds_metadata_missing definition final inheriting from cx_static_check.
endclass.

class lcl_bo_trees definition final.
  public section.
    methods get_parent_info
      importing entity_name type abp_entity_name
      exporting value(parent_name) type abp_entity_name
                value(to_child_asso_name) type string
      raising lcx_cds_metadata_missing.
  private section.
    types: begin of t_bo_node,
      entity_name        type abp_entity_name,
      parent_name        type abp_entity_name,
      to_child_asso_name type string,
      entity_assos       type if_dd_rtobj_types=>t_catalog_associations,
    end of t_bo_node.
    types: t_bo_tree type hashed table of t_bo_node with unique key entity_name.
    data bo_cache type t_bo_tree.
endclass.

class lcl_bo_trees implementation.
  method get_parent_info.
    read table bo_cache with table key entity_name = entity_name assigning field-symbol(<node>).
    if sy-subrc eq 0.
      if <node>-parent_name is not initial.
        parent_name = <node>-parent_name.
        to_child_asso_name = <node>-to_child_asso_name.
        return.
      endif.
    else.
      data view type ref to if_dd_rtobj_assoc_source.
      try.
        view ?= cl_dd_rtobj_factory=>read_active_rtobj( entity_name ).
      catch cx_dd_rtobj.
        raise exception type lcx_cds_metadata_missing.
      endtry.
      insert value t_bo_node( entity_name = entity_name entity_assos = view->get_associations( ) )
        into table bo_cache assigning <node>.
    endif.
    read table <node>-entity_assos with key kind = sabp_dd_catalog_type=>association_kind-to_parent
      assigning field-symbol(<parent_asso>).
    if sy-subrc ne 0.
      return. "root instance
    endif.
    parent_name = <node>-parent_name = <parent_asso>-target_name.
    read table bo_cache with table key entity_name = parent_name assigning field-symbol(<pnode>).
    if sy-subrc ne 0.
      try.
        view ?= cl_dd_rtobj_factory=>read_active_rtobj( parent_name ).
      catch cx_dd_rtobj.
        raise exception type lcx_cds_metadata_missing.
      endtry.
      insert value t_bo_node( entity_name = parent_name entity_assos = view->get_associations( ) )
        into table bo_cache assigning <pnode>.
    endif.
    read table <pnode>-entity_assos with key kind = sabp_dd_catalog_type=>association_kind-composition target_name = entity_name
      assigning field-symbol(<child_asso>).
    if sy-subrc ne 0.
      raise exception type lcx_cds_metadata_missing.
    endif.
    to_child_asso_name = <node>-to_child_asso_name = <child_asso>-name.
  endmethod.
endclass.

