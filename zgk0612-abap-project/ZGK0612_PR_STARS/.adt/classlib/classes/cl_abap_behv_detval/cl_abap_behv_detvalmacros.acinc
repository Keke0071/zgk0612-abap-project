define xtrace_get_trace_level.
  if sxt_tracer->is_active( component = c_sxt_comp_dvm trace_level = c_xtrace_essential ).
    if sxt_tracer->is_active( component = c_sxt_comp_dvm trace_level = c_xtrace_extended ).
      if sxt_tracer->is_active( component = c_sxt_comp_dvm trace_level = c_xtrace_expert ).
        if sxt_tracer->is_active( component = c_sxt_comp_dvm trace_level = c_xtrace_verbose ).
          sxt_trace_level = c_xtrace_verbose.
        else.
          sxt_trace_level = c_xtrace_expert.
        endif.
      else.
        sxt_trace_level = c_xtrace_extended.
      endif.
    else.
      sxt_trace_level = c_xtrace_essential.
    endif.
  else.
    sxt_trace_level = 0.
  endif.
end-of-definition.

define xtrace_msg.
  if sxt_trace_level >= &1.
    sxt_tracer->trace( component = c_sxt_comp_dvm trace_level = &1
                       message = &2
                       object = conv #( text-007 )
                       procedure = &3 ).
  endif.
end-of-definition.

define xtrace_add_notif.
  if sxt_trace_level >= &1.
    trace_beg_add_change_notif_tab( changes = &2
                                    for_eml = &3 ).
  endif.
end-of-definition.

define xtrace_call1.
  if sxt_trace_level >= &1.
    &2( &3 ).
  endif.
end-of-definition.

define xtrace_beg_exec.
  if sxt_trace_level >= &1.
    data(hierarchy_number) = trace_beg_exec_detval( params = &2 root_name = &3 proc_name = &4 ).
  endif.
end-of-definition.

define xtrace_beg_exec2.
  if sxt_trace_level >= &1.
    data(hierarchy_number) = trace_beg_exec_detval( root_name = &2 proc_name = &3 ).
  endif.
end-of-definition.