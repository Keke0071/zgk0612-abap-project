class ltc_bo_trees definition
  final for testing duration short risk level harmless.
  public section.
    methods test_get_parent_info for testing.
    methods test_get_parent_of_root for testing.
endclass.

class ltc_bo_trees implementation.
  method test_get_parent_info.
    try.
      new lcl_bo_trees( )->get_parent_info( 'MICH_GIBT_ES_NICHT' ).
    catch lcx_cds_metadata_missing into data(lcx) ##NO_HANDLER.
    endtry.
    cl_aunit_assert=>assert_not_initial( act = lcx msg = 'Expected exception was not raised' ).
  endmethod.
  method test_get_parent_of_root.
    try.
      new lcl_bo_trees( )->get_parent_info( exporting entity_name        = 'SCIBEHV_M_DBDEV'
                                            importing parent_name        = data(pn)
                                                      to_child_asso_name = data(ch) ).
    catch lcx_cds_metadata_missing into data(lcx) ##NO_HANDLER.
    endtry.
    cl_aunit_assert=>assert_initial( act = lcx msg = 'Expected exception was raised' ).
    cl_aunit_assert=>assert_initial( act = pn  msg = 'Unexpected parent name' ).
    cl_aunit_assert=>assert_initial( act = ch  msg = 'Unexpected to_child_asso_name' ).
  endmethod.
endclass.

class ltc_feature_toggle_off  definition final for testing
    duration short risk level harmless.
  public section.
    methods save_opt1 for testing.
    class-data test_dvm_no_dumps type ref to object.
  private section.
    class-methods class_setup.
endclass.

class ltc_feature_toggle_off implementation.
  method class_setup.
    cl_abap_switch=>set_switch_states_for_tests( p_temp_states = value #( ( switch_id = 'IC_2311_DET_ACT_OPT' state = cl_abap_switch=>c_off ) )  ).
    try.
      create object test_dvm_no_dumps type (`CL_SVER_DVM`)
        exporting dvm = new ltc_detval_no_dumps( ).
    catch cx_sy_create_object_error.
      cl_aunit_assert=>abort( msg = `Need HOME objects for execution` ).
    endtry.
  endmethod.
  method save_opt1.
    call method test_dvm_no_dumps->('SAVE_OPT1').
  endmethod.
endclass.

