class ltd_sxt_tracer definition final for testing
    duration short risk level harmless.
  public section.
    interfaces if_sxt_tracer.
    methods constructor
      importing trace_level type if_sxt_types=>ty_trace_level.
  private section.
    data mock_trace_level type if_sxt_types=>ty_trace_level.
endclass.

class ltd_sxt_tracer implementation.
  method constructor.
    me->mock_trace_level = trace_level.
  endmethod.

  method if_sxt_tracer~add_header_properties ##NEEDED.
  endmethod.

  method if_sxt_tracer~begin_hierarchy ##NEEDED.
    hierarchy_number = 1.
  endmethod.

  method if_sxt_tracer~end_hierarchy ##NEEDED.
  endmethod.

  method if_sxt_tracer~is_active.
    if trace_level <= mock_trace_level.
      active = 'X'.
    endif.
  endmethod.

  method if_sxt_tracer~is_any_active ##NEEDED.
  endmethod.

  method if_sxt_tracer~trace ##NEEDED.
  endmethod.
endclass.

