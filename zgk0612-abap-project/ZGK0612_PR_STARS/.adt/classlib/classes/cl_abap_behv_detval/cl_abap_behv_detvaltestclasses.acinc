      importing
        mock_trace_level type if_sxt_types=>ty_trace_level optional.
  protected section.
    methods dump redefinition.
endclass.

class ltc_detval_no_dumps implementation.
  method constructor.
    super->constructor( ).
    if mock_trace_level is not initial.
      me->sxt_tracer = new ltd_sxt_tracer( mock_trace_level ).
    endif.
  endmethod.

  method dump.
    if conv i( kind ) > 0. "no internal error
      dump_xtrace( kind ).
      call method ltc_abap_behv_detval_hometests=>test_dvm_no_dumps->('DUMP') exporting kind = conv i( kind ).
    else.
      super->dump( kind ).
    endif.
  endmethod.
endclass.

