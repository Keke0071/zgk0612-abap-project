class ltc_add_notifications definition final.
  public section.
    interfaces if_abap_behv_detval.
    data changes type cl_abap_behv_detval=>tt_cud_instances ##needed.
endclass.

class ltc_add_notifications implementation.
  method if_abap_behv_detval~add_change_notification_tab.
    data ref type ref to data.
    clear me->changes.
    loop at changes into data(change).
      assign change-instances->* to field-symbol(<tab>).
      create data ref like <tab>.
      assign ref->* to field-symbol(<tab_copy>).
      <tab_copy> = <tab>.
      change-instances = ref.
      append change to me->changes.
    endloop.
  endmethod.

  method if_abap_behv_detval~cleanup ##NEEDED.
  endmethod.

  method if_abap_behv_detval~exec_determinations_on_modify ##NEEDED.
  endmethod.

  method if_abap_behv_detval~exec_determinations_on_save ##NEEDED.
  endmethod.

  method if_abap_behv_detval~exec_determine_action ##NEEDED.
  endmethod.

  method if_abap_behv_detval~exec_validations ##NEEDED.
  endmethod.

  method if_abap_behv_detval~check_finalize_is_complete ##NEEDED.
  endmethod.

  method if_abap_behv_detval~cleanup_finalize ##NEEDED.
  endmethod.

  method if_abap_behv_detval~read_control_flags ##NEEDED.

  endmethod.

endclass.

