CLASS cl_oo_adt_res_classrun DEFINITION
  PUBLIC
  INHERITING FROM cl_adt_rest_resource
  FINAL
  CREATE PUBLIC.

  PUBLIC SECTION.
    CONSTANTS:
      co_err_cls_unknown   TYPE string VALUE 'Error: Unknown error occured!' ##NO_TEXT,
      co_err_cls_nt_implmt TYPE string VALUE 'Error: Class does not implement if_oo_adt_classrun~main method!' ##NO_TEXT,
      co_err_cls_cnstrctr  TYPE string VALUE 'Error: Do not overwrite the class constructor!' ##NO_TEXT,
      co_err_osql_dyn_call TYPE string VALUE 'Error: Dynamic call parameter missing exception!' ##NO_TEXT,
      co_err_ddl_exec      TYPE string VALUE 'Error: Core Data Service exception!' ##NO_TEXT.

    METHODS post REDEFINITION.

  PROTECTED SECTION.

  PRIVATE SECTION.
    CONSTANTS co_header_communication_id TYPE string VALUE 'sap-adt-push-communication-id' ##NO_TEXT.
    CONSTANTS co_header_request_id       TYPE string VALUE 'sap-adt-push-request-id' ##NO_TEXT.
    CONSTANTS co_amc_application_id      TYPE string VALUE 'ZAIE2' ##NO_TEXT.
    CONSTANTS co_amc_channel_id          TYPE string VALUE '/classrun' ##NO_TEXT.

    CLASS-DATA mv_amc_application_id   TYPE amc_application_id       VALUE co_amc_application_id ##NO_TEXT.
    CLASS-DATA mv_amc_channel_id       TYPE amc_channel_id           VALUE co_amc_channel_id ##NO_TEXT.
    CLASS-DATA mv_adt_communication_id TYPE amc_channel_extension_id.
    CLASS-DATA mv_adt_request_id       TYPE string.

    DATA mv_output TYPE xstring.

    METHODS execute_ddls
      IMPORTING iv_objectname TYPE objectname
                iv_devclass   TYPE devclass
                i_output      TYPE REF TO if_oo_adt_classrun_out.

    METHODS execute_clas
      IMPORTING iv_objectname TYPE objectname
                i_output      TYPE REF TO if_oo_adt_classrun_out
                i_profiler_id TYPE string OPTIONAL
      RAISING   cx_parameter_invalid_range
                cx_parameter_invalid_type
                cx_sy_codepage_converter_init
                cx_sy_conversion_codepage.

    METHODS activate_abap_trace
      IMPORTING i_classname   TYPE objectname
                i_profiler_id TYPE string.
ENDCLASS.



CLASS CL_OO_ADT_RES_CLASSRUN IMPLEMENTATION.


  METHOD activate_abap_trace.
    DATA:
      l_wb_object TYPE REF TO cl_wb_object,
      l_reference TYPE REF TO cl_adt_object_reference.

    l_wb_object =
      cl_wb_object=>create_from_transport_key( p_object   = 'CLAS'
                                               p_obj_name = CONV #( i_classname ) ).

    TRY.
        l_reference =
          cl_adt_tools_core_factory=>get_instance(
             )->get_uri_mapper(
               )->map_wb_object_to_objref( wb_object = l_wb_object ).

        cl_atradt_instant_tracing=>s_gui_start_trace( i_uri       = l_reference->ref_data-uri
                                                      i_params_id = i_profiler_id
                                                      i_execute   = ''  ).

      CATCH cx_adt_uri_mapping.
        RETURN.

    ENDTRY.
  ENDMETHOD.


  METHOD execute_clas.
    CONSTANTS co_object_type TYPE if_abap_language_version=>ty_object_type VALUE 'CLAS'.
    CONSTANTS co_activity    TYPE if_abap_language_version=>ty_activity    VALUE '16'.

    DATA is_user_authorized TYPE abap_bool.
    DATA lv_objectname      TYPE if_abap_language_version=>ty_object_name.
    DATA lo_console_app     TYPE REF TO if_oo_adt_classrun.

    DATA(lo_abap_language_version) = cl_abap_language_version=>get_instance( ).

    SELECT SINGLE FROM tadir
      FIELDS devclass
      WHERE obj_name = @iv_objectname
      AND object = @co_object_type
      AND pgmid = 'R3TR'
      INTO @DATA(lv_devclass).

    AUTHORITY-CHECK OBJECT 'S_DEVELOP'
                    ID 'DEVCLASS' FIELD lv_devclass
                    ID 'OBJTYPE' FIELD co_object_type
                    ID 'OBJNAME' FIELD iv_objectname
                    ID 'P_GROUP' DUMMY
                    ID 'ACTVT' FIELD co_activity.
    IF sy-subrc <> 0.
      MESSAGE ID 'OO' TYPE 'E' NUMBER 755
              INTO DATA(lv_message).
      mv_output = cl_abap_codepage=>convert_to( lv_message ).
    ELSE.

      TRY.
          lv_objectname = iv_objectname.
          IF lo_abap_language_version->is_object_type_supported( co_object_type ).
            DATA ls_abap_language_version TYPE if_abap_language_version=>ty_gs_object_version.
            TEST-SEAM abplngvs_get_version_of_object.
              ls_abap_language_version = lo_abap_language_version->get_version_of_object(
                                             iv_object_type  = co_object_type
                                             iv_object_name  = lv_objectname
                                             iv_object_state = if_abap_language_version=>gc_object_state-active ).
            END-TEST-SEAM.

            TEST-SEAM abplngvs_is_user_authorized.
              is_user_authorized = lo_abap_language_version->is_user_authorized(
                                       iv_object_type = co_object_type
                                       iv_version     = ls_abap_language_version-id
                                       iv_activity    = co_activity ).
            END-TEST-SEAM.

            IF NOT abap_true = is_user_authorized.
              MESSAGE ID 'OO' TYPE 'E' NUMBER 755
                      INTO DATA(lv_message_abplngvs).
              mv_output = cl_abap_codepage=>convert_to( lv_message_abplngvs ).
              EXIT.
            ENDIF.

          ENDIF.

          DATA lv_seoclskey TYPE seoclskey.
          lv_seoclskey-clsname = iv_objectname.

          DATA lt_seor_implementing_keys TYPE seor_implementing_keys.

          TEST-SEAM seo_class_all_implementg_get.
            CALL FUNCTION 'SEO_CLASS_ALL_IMPLEMENTG_GET'
              EXPORTING
                clskey  = lv_seoclskey
                version = seoc_version_active
              IMPORTING
                set     = lt_seor_implementing_keys
              EXCEPTIONS
                OTHERS  = 4.
            IF sy-subrc <> 0.
              mv_output = cl_abap_codepage=>convert_to( co_err_cls_unknown ).

            ENDIF.
          END-TEST-SEAM.

          FINAL(lv_cp_mess) = NEW cl_abap_docu_class_pool( CONV #( lv_seoclskey ) )->check_adt_classrun( ).
          IF lv_cp_mess IS NOT INITIAL.
            mv_output = cl_abap_codepage=>convert_to( lv_cp_mess ).
            RETURN.
          ENDIF.

          EXPORT adt_console_flag = abap_true TO MEMORY ID 'ADT_CONSOLE_FLAG'.

          DATA b TYPE abap_bool VALUE abap_false.

          LOOP AT lt_seor_implementing_keys ASSIGNING FIELD-SYMBOL(<fldsym>).
            IF <fldsym>-refclsname = 'IF_OO_ADT_CLASSRUN' ##NO_TEXT.
              b = abap_true.
            ENDIF.
          ENDLOOP.

          IF b = abap_false.
            mv_output = cl_abap_codepage=>convert_to( co_err_cls_nt_implmt ).
            EXIT.
          ENDIF.

          " activate tracing
          IF i_profiler_id IS NOT INITIAL.
            activate_abap_trace( i_classname   = iv_objectname
                                 i_profiler_id = i_profiler_id ).

            IF     cl_atradt_instant_tracing=>s_ref_trace_session             IS NOT INITIAL
               AND cl_atradt_instant_tracing=>s_ref_trace_session->flg_on_off IS INITIAL.
              SET RUN TIME ANALYZER ON %_INTERNAL.
            ENDIF.
          ENDIF.

          " *** CALL CONSOLE APP ***
          CREATE OBJECT lo_console_app TYPE (iv_objectname).
          lo_console_app->main( i_output ).
          " *** CALL CONSOLE APP ***

          " deactivate tracing
          IF i_profiler_id IS NOT INITIAL AND cl_atradt_instant_tracing=>s_ref_trace_session IS NOT INITIAL.
            IF cl_atradt_instant_tracing=>s_ref_trace_session->flg_on_off IS INITIAL.
              SET RUN TIME ANALYZER OFF %_INTERNAL.
            ELSE.
              SET RUN TIME ANALYZER OFF.
            ENDIF.
            cl_atradt_instant_tracing=>s_gui_stop_trace( ).
          ENDIF.

          DATA(output) = i_output->get( ).
          mv_output = cl_abap_codepage=>convert_to( output ).

        CATCH cx_sy_create_object_error cx_sy_dyn_call_param_missing cx_abap_language_version INTO DATA(lx_data).

          IF i_profiler_id IS NOT INITIAL AND cl_atradt_instant_tracing=>s_ref_trace_session IS NOT INITIAL.
            IF cl_atradt_instant_tracing=>s_ref_trace_session->flg_on_off IS INITIAL.
              SET RUN  TIME ANALYZER OFF %_INTERNAL.
            ELSE.
              SET RUN  TIME ANALYZER OFF.
            ENDIF.
            cl_atradt_instant_tracing=>s_gui_stop_trace( ).
          ENDIF.

          IF lx_data IS NOT INITIAL.
            mv_output =  cl_abap_codepage=>convert_to( lx_data->get_text( ) ).
          ELSE.
            mv_output = cl_abap_codepage=>convert_to( co_err_cls_unknown ).
          ENDIF.

      ENDTRY.
    ENDIF.

    DATA(lv_result_demo) = ``.
    DELETE FROM MEMORY ID 'ADT_CONSOLE_FLAG'.
    IMPORT result_text = lv_result_demo FROM MEMORY ID 'RESULT_TEXT'.
    DATA(lv_result_demo_hex) = cl_abap_codepage=>convert_to( |\n| && lv_result_demo ).

    CONCATENATE mv_output lv_result_demo_hex INTO mv_output IN BYTE MODE. " Double output prevented in CL_DEMO_OUTPUT_TEXT
  ENDMETHOD.


  METHOD execute_ddls.
    " DDLS is currently not supported

*    CONSTANTS co_number_of_rows TYPE i VALUE 10.
*
*    TRY.
*        cl_dd_ddl_handler_factory=>create( )->get_ddl_content_object_names(
*          EXPORTING
*            ddlname        =     CONV #( iv_objectname )
*          IMPORTING
*            viewname       =     DATA(lv_viewname)
*            entityname     =     DATA(lv_entityname)
*        ).
*      CATCH cx_static_check INTO DATA(ex_dd_ddl_read).
*        i_output->write( co_err_ddl_exec ).
*    ENDTRY.
*
*    TRY.
*
*        IF lv_entityname IS NOT INITIAL.
*
*          TRY.
*              DATA lv_count TYPE int8.
*              DATA lr_data TYPE REF TO data.
*              DATA(lv_objectname) = cl_abap_dyn_prg=>check_table_or_view_name_str(
*                                                        val = lv_viewname packages = iv_devclass  ).
*              CREATE DATA lr_data TYPE TABLE OF (lv_objectname).
*              FIELD-SYMBOLS <ft_data> TYPE INDEX TABLE.
*              ASSIGN lr_data->* TO <ft_data>.
*
*              AUTHORITY-CHECK OBJECT 'S_DEVELOP'
*                 ID 'DEVCLASS' DUMMY
*                 ID 'OBJTYPE' FIELD 'DDLS'
*                 ID 'OBJNAME' FIELD iv_objectname
*                 ID 'P_GROUP' DUMMY
*                 ID 'ACTVT' FIELD '16'.
*              IF sy-subrc NE 0.
*                MESSAGE ID 'OO' TYPE 'E' NUMBER 755
*                  INTO DATA(lv_message3).
*                i_output->write( lv_message3 ).
*              ELSE.
*
*                SELECT COUNT(*) FROM (lv_objectname)
*                  INTO @lv_count.
*
*                GET RUN TIME FIELD DATA(t1).
*
*                IF lv_count > co_number_of_rows.
*
*                  SELECT * FROM (lv_objectname)
*                    INTO CORRESPONDING FIELDS OF TABLE @<ft_data>
*                    UP TO @co_number_of_rows ROWS.
*
*                  GET RUN TIME FIELD DATA(t2).
*                  DATA(t) = ( t2 - t1 ) / 1000.
*
*                  DATA: l_timestamp TYPE timestamp, l_date TYPE d, l_time TYPE t.
*                  GET TIME STAMP FIELD l_timestamp.
*                  CONVERT TIME STAMP l_timestamp TIME ZONE sy-zonlo INTO DATE l_date TIME l_time.
*
*                  i_output->write(
*                    EXPORTING
*                      data  = <ft_data>
*                  ).
*
*                  i_output->write( data =  |Date: { l_date } Time: { l_time } Runtime: { t } ms | ) ##NO_TEXT.
*
*                  DATA(lv_text) = |Caution: View { lv_viewname } contains { lv_count } rows .... only the first { co_number_of_rows } rows are displayed!| ##NO_TEXT.
*                  i_output->write( lv_text ).
*
*                ELSE.
*                  SELECT * FROM (lv_objectname)
*                    INTO CORRESPONDING FIELDS OF TABLE @<ft_data>.
*                  i_output->write(
*                    EXPORTING
*                      data  = <ft_data>
*                  ).
*                ENDIF.
*
*                DATA(lv_info) = | CDS source: { iv_objectname } / CDS entity: { lv_entityname } / SQL view: { lv_viewname } | ##NO_TEXT.
*                i_output->write( lv_info ).
*
*              ENDIF.
*
*            CATCH cx_sy_dynamic_osql_syntax cx_sy_dynamic_osql_semantics INTO DATA(ex_sy_dynamic_osql).
*              i_output->write( co_err_osql_dyn_call ).
*            CATCH cx_abap_not_a_table  INTO DATA(ex_abap_not_a_table).
*              i_output->write( | { co_err_osql_dyn_call } : { ex_abap_not_a_table->get_text( ) } | ).
*          ENDTRY.
*
*        ENDIF.
*      CATCH cx_sy_dyn_call_param_missing INTO DATA(ex_sy_dyn_call_param_missing).
*        i_output->write( co_err_osql_dyn_call ).
*        mv_output = cl_abap_codepage=>convert_to( co_err_osql_dyn_call ).
*      CATCH cx_abap_not_in_package INTO DATA(ex_abap_not_in_package).
*        i_output->write( ex_abap_not_in_package->get_text( ) ).
*      CATCH cx_static_check INTO DATA(ex_dd_ddl_exception).
*        i_output->write( co_err_ddl_exec ).
*    ENDTRY.
*
*
*    DATA(lv_output) = i_output->get( ).
*    mv_output = cl_abap_codepage=>convert_to( lv_output ).
  ENDMETHOD.


  METHOD post.
    DATA lv_objectname   TYPE objectname.
    DATA content_handler TYPE REF TO if_adt_rest_content_handler.
    DATA l_profiler_id   TYPE string.

    request->get_uri_query_parameter( EXPORTING name      = 'profilerId'
                                                mandatory = abap_false
                                      IMPORTING value     = l_profiler_id    ).

    request->get_uri_attribute( EXPORTING name      = 'classname' ##NO_TEXT
                                          mandatory = abap_true
                                IMPORTING value     = lv_objectname ).

    mv_adt_communication_id = request->get_inner_rest_request( )->get_header_field( iv_name = co_header_communication_id ).
    mv_adt_request_id = request->get_inner_rest_request( )->get_header_field( iv_name = co_header_request_id ).

    TRANSLATE lv_objectname TO UPPER CASE.

    SELECT FROM tadir
      FIELDS pgmid, object, obj_name, devclass
      WHERE pgmid = 'R3TR' AND obj_name = @lv_objectname AND ( object = 'DDLS' OR object = 'CLAS' )
      ORDER BY pgmid, object, obj_name
      INTO @DATA(ls_data).                              "#EC CI_GENBUFF
    ENDSELECT.

    IF ls_data-object = 'CLAS' OR ls_data-object = ''.

      DATA(output) = cl_oo_adt_classrun_output=>new( cl_oo_adt_classrun_output=>text_mode ).
      execute_clas( iv_objectname = lv_objectname
                    i_profiler_id = l_profiler_id
                    i_output      = output ).
    ENDIF.

    content_handler =  cl_adt_rest_comp_cnt_handler=>create(
        content_handler = cl_adt_rest_cnt_hdl_factory=>get_instance( )->get_handler_for_binary_data( if_rest_media_type=>gc_text_plain )
        request         = request ).

    response->set_body_data( content_handler = content_handler
                             data            = mv_output ).
  ENDMETHOD.
ENDCLASS.