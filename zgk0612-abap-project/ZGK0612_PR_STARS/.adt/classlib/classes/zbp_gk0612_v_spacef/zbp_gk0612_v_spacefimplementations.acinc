CLASS lhc_Spacefarer DEFINITION INHERITING FROM cl_abap_behavior_handler.
  PRIVATE SECTION.

    METHODS get_instance_authorizations FOR INSTANCE AUTHORIZATION
      IMPORTING keys REQUEST requested_authorizations FOR Spacefarer RESULT result.

    METHODS get_global_authorizations FOR GLOBAL AUTHORIZATION
      IMPORTING REQUEST requested_authorizations FOR Spacefarer RESULT result.

    METHODS precheck_create FOR PRECHECK
      IMPORTING entities FOR CREATE Spacefarer.

    METHODS precheck_update FOR PRECHECK
      IMPORTING entities FOR UPDATE Spacefarer.
    METHODS check_dust_collection FOR VALIDATE ON SAVE
      IMPORTING keys FOR Spacefarer~check_dust_collection.

ENDCLASS.

CLASS lhc_Spacefarer IMPLEMENTATION.

  METHOD get_instance_authorizations.
  ENDMETHOD.

  METHOD get_global_authorizations.
  ENDMETHOD.

  METHOD precheck_create.

    LOOP AT entities ASSIGNING FIELD-SYMBOL(<lfs_entity>).
      IF <lfs_entity>-wormhole_skill + <lfs_entity>-reputation >= 99.
        APPEND VALUE #(
          %key = <lfs_entity>-%key
          %msg = new_message_with_text(
            severity = if_abap_behv_message=>severity-error
            text = 'Navigation + Reputation must be < 99'
          )
        ) TO reported-spacefarer.

        APPEND VALUE #(
            %key = <lfs_entity>-%key
            ) TO failed-spacefarer.

      ENDIF.
    ENDLOOP.

  ENDMETHOD.

  METHOD precheck_update.

    LOOP AT entities ASSIGNING FIELD-SYMBOL(<lfs_entity>).
      IF <lfs_entity>-wormhole_skill + <lfs_entity>-reputation >= 99.
        APPEND VALUE #(
          %key = <lfs_entity>-%key
          %msg = new_message_with_text(
            severity = if_abap_behv_message=>severity-error
            text = 'Navigation + Reputation must be < 99'
          )
        ) TO reported-spacefarer.

        APPEND VALUE #(
            %key = <lfs_entity>-%key
            ) TO failed-spacefarer.

      ENDIF.
    ENDLOOP.

  ENDMETHOD.


  METHOD check_dust_collection.

  ENDMETHOD.

ENDCLASS.