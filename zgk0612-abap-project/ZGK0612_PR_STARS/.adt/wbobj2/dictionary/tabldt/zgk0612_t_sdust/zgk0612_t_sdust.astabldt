@EndUserText.label : 'Stardust Collection'
@AbapCatalog.enhancement.category : #NOT_EXTENSIBLE
@AbapCatalog.tableCategory : #TRANSPARENT
@AbapCatalog.deliveryClass : #A
@AbapCatalog.dataMaintenance : #RESTRICTED
define table zgk0612_t_sdust {

  key id          : abap.int2 not null;
  collection_id   : abap.int2;
  color           : abap.char(30);
  weight          : abap.dec(10,3);
  state_of_matter : abap.char(20);
  @AbapCatalog.decfloat.outputStyle : #NORMAL
  value           : abap.decfloat16;

}